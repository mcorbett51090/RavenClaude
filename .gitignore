# RavenClaude marketplace — ignore consumer-side runtime artifacts and local config.

# Comfort-posture run artifacts (Thing audit logs, runaway counters, hook-events.jsonl, etc.)
.ravenclaude/runs/

# Agentic Work-Streams (local resume store — derived labels only, machine-local)
.ravenclaude/streams/

# Posture-change audit log (per-project, append-only — P0.4 event substrate)
.ravenclaude/posture-events.jsonl
# Per-machine handoff spawn marker; consumed by the successor's SessionStart hook.
# Task_id-scoped (handoff-pending-<slug>.json) since handoff-spawn.sh v0.313.x —
# the glob also matches the legacy unscoped handoff-pending.json name.
.ravenclaude/handoff-pending*.json

# inventory-nuance-judge.py's content-hash calibration/entry cache — machine- and
# model-behavior-specific, never meant to be shared or committed.
.ravenclaude/cache/

# /repo-review's review_cache.py content-hash cache (scripts/repo_map.py CACHE_DIR) —
# machine-local, per-run, never meant to be committed. Gap found 2026-09-10: the first
# real dev-repo /repo-review run left 602 untracked JSON files that failed prettier's
# whole-tree --check (prettier respects .gitignore, so this closes it for good).
.ravenclaude/repo-review-cache/

# Local/runtime config — not part of the committed marketplace (rc-deep-research
# substrate baseline arm + local self-heal setup notes). Templates live in
# plugins/ravenclaude-core/templates/; the live per-repo copies stay local.
.ravenclaude/run-config.json
.ravenclaude/self-heal-setup.md

# Per-worktree lane identity (written by rcwt / write-lane-stamp.sh). Not constitution.
.ravenclaude/lane.md

# Local dashboard server logs
*.log

# Node modules (if any tooling is added)
node_modules/

# Editor / OS noise
.DS_Store
.vscode/

# Local Claude Code runtime state
.claude/scheduled_tasks.lock
.claude/__pycache__/
.claude/.comfort-posture-applied.local.json

# Python cache
*.pyc
**/__pycache__/
.claude/settings.local.json

# Evals — consumer-run artifacts and private fixtures must never be committed
evals/results/
evals/**/*.private.*

# Bytecode for the new evals harness
evals/__pycache__/
.claude/worktrees/

# browser-verification debris (Playwright)
.playwright-mcp/
*-rendered.png

# report-regeneration test output — regenerated reports and QA artifacts written
# by the plugin's skills during a run; never source, never committed.
tests/fixtures/report-regeneration/_out/
.ravenclaude/handoff-nudge-state.json
.ravenclaude/handoff-nudge-state/

# F3 golden-set light judge reports (artifact-only; never commit churn)
evals/reports/
evals/inject-golden-set/__pycache__/
