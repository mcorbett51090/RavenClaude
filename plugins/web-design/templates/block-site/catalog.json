      "slots": ["content"],
      "props": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "items"],
        "properties": {
          "heading": {
            "type": "string",
            "maxLength": 60,
            "minLength": 3
          },
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label", "source"],
              "properties": {
