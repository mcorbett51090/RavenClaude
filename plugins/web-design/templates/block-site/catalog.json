{
  "description": "The kit's exemplar block contracts (thirteen), one entry per block, each shaped by block.schema.json. block_site_check.py reads this file or a directory of <id>/block.json files; split it into that form when the catalog grows, so each block's contract sits beside its component.",
  "blocks": [
    {
      "id": "hero-full",
      "version": "2.0.0",
      "title": "Full-bleed photo hero",
      "summary": "The page's opening statement over a strong photograph of the business itself. Use for a home or landing page. Not without a business-own photo: use page-header instead.",
      "category": "hero",
      "headingLevel": 1,
      "placement": {
        "position": "first",
        "maxPerPage": 1,
        "notAdjacentTo": ["cta-banner"]
      },
      "tone": {
        "default": "media",
        "locked": true
      },
      "slots": ["backdrop", "content"],
      "space": "l",
      "props": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "image"],
        "properties": {
          "eyebrow": {
            "type": "string",
            "maxLength": 48
          },
          "title": {
            "type": "string",
            "maxLength": 60,
            "minLength": 3
          },
          "lede": {
            "type": "string",
            "maxLength": 180
          },
          "image": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 60
          },
          "actions": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "href"],
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 28,
                  "minLength": 2
                },
                "href": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "kind": {
                  "enum": ["primary", "ghost"]
                }
              }
            }
          }
        }
      },
      "assetProps": ["image"],
      "linkProps": ["actions[].href"],
      "media": [
        {
          "prop": "image",
          "ratio": "16 / 9",
          "slot": "full",
          "priority": true,
          "maxWidth": 1280,
          "maxHeight": 704,
          "provenance": ["business-own", "commissioned"]
        }
      ],
      "a11y": [
        "Renders the page's only h1. The photo is decorative (alt=\"\"): the copy says what matters.",
        "The copy sits on a scrim anchored to it (layout.css), and device_matrix.mjs scores every line against the composited photo at each device class (photo-contrast)."
      ],
      "perf": {
        "clientJs": "none",
        "lcpCandidate": true
      },
      "truth": [
        "Never a photo of another business, and never a stock photo presented as this place.",
        "The founding year and any claim in the eyebrow come from the business's own records."
      ]
    },
    {
      "id": "page-header",
      "version": "1.0.0",
      "title": "Page header",
      "summary": "An inner page's title and one-paragraph introduction, with no photo. The level-1 block for every page that is not a landing page. Not for the home page when a business-own photo exists: use hero-full.",
      "category": "hero",
      "headingLevel": 1,
      "placement": {
        "position": "first",
        "maxPerPage": 1
      },
      "tone": {
        "default": "canvas",
        "allowed": ["canvas", "surface"]
      },
      "slots": ["content"],
      "space": "m",
      "props": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "eyebrow": {
            "type": "string",
            "maxLength": 40
