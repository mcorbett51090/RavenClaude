      "a11y": [
        "A description list: each label is the term and its number the description, so a screen reader hears them paired. The numbers sit side by side or all stacked, never two-and-one."
      ],
      "perf": {
        "clientJs": "none"
      },
      "truth": [
        "Every number has a source a customer could check; the source is rendered under it."
      ]
    },
    {
