{
  "description": "The kit's exemplar block contracts, one entry per block, each shaped by block.schema.json. block_site_check.py reads this file or a directory of <id>/block.json files; split it into that form when the catalog grows, so each block's contract sits beside its component.",
  "blocks": [
    {
      "id": "hero-full",
      "version": "1.0.0",
      "title": "Full-bleed photo hero",
      "summary": "The page's opening statement over one strong photo: eyebrow, title, a short lede and up to two actions. Use for a home page with a photo that carries the place. Avoid when no business-own or licensed photo exists (use a text hero instead).",
      "category": "hero",
      "headingLevel": 1,
      "placement": {
        "position": "first",
        "maxPerPage": 1,
        "notAdjacentTo": ["cta-banner"]
      },
      "tone": {
        "default": "media",
        "locked": true
      },
      "slots": ["backdrop", "content"],
      "space": "l",
      "variants": ["photo", "video"],
      "props": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "image"],
        "properties": {
          "variant": {
            "enum": ["photo", "video"]
          },
          "eyebrow": {
            "type": "string",
            "maxLength": 48
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "lede": {
            "type": "string",
            "maxLength": 180
          },
          "image": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 60
          },
          "focal": {
            "type": "string",
            "pattern": "^\\d{1,3}% \\d{1,3}%$",
            "maxLength": 9
          },
          "actions": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "href"],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 28
                },
                "href": {
                  "type": "string",
                  "maxLength": 200
                },
                "kind": {
                  "enum": ["primary", "ghost"]
                }
              }
            }
          }
        }
      },
      "assetProps": ["image"],
      "linkProps": ["actions[].href"],
      "media": [
        {
          "prop": "image",
          "ratio": "16 / 9",
          "slot": "full",
          "priority": true
        }
      ],
      "schemaOrg": [],
      "a11y": [
        "Renders the page's only h1; the photo is decorative (alt=\"\") because the copy states what matters.",
        "Copy sits on a scrim anchored to the text, measured by the photo-contrast method at every device class.",
        "A video variant pauses under prefers-reduced-motion and has a visible pause button."
      ],
      "perf": {
        "clientJs": "none",
        "lcpCandidate": true
      },
      "truth": [
        "Never a photo of another business, and never a stock photo presented as this place.",
        "The founding year and any claim in the eyebrow come from the business's own records."
      ]
    },
    {
      "id": "features-grid",
      "version": "1.0.0",
      "title": "Feature cards",
      "summary": "One to six short reasons or offerings as cards, laid out by count (never a card alone on a row). Use for 'why us' or a services overview. Avoid for a menu or price list (use a list block) or for more than six items.",
      "category": "content",
      "headingLevel": 2,
      "placement": {
        "position": "any",
        "maxPerPage": 2
      },
      "tone": {
        "default": "canvas",
        "allowed": ["canvas", "surface"]
      },
      "slots": ["content"],
      "variants": ["plain", "with-icon"],
      "props": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "items"],
        "properties": {
          "variant": {
            "enum": ["plain", "with-icon"]
          },
          "eyebrow": {
            "type": "string",
            "maxLength": 40
          },
          "heading": {
            "type": "string",
            "minLength": 3,
            "maxLength": 70
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "body"],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 48
                },
                "body": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 160
                },
                "icon": {
                  "enum": ["clock", "leaf", "star", "heart", "map", "phone", "cup", "check"]
                }
              }
            }
          }
        }
      },
      "a11y": [
        "An h2 for the block and an h3 per card; cards are articles in reading order, which is also the visual order at every width."
      ],
      "perf": {
        "clientJs": "none"
      },
      "truth": [
        "Every claim on a card is something the business does today; no awards or ratings without a source."
      ]
    },
    {
      "id": "story-split",
      "version": "1.0.0",
      "title": "Story with photo",
      "summary": "A photo beside a few paragraphs, side by side when the slot is wide enough and stacked when it is not (a switcher, so there is no squeezed in-between). Use for an about or history section. Avoid when the text runs past four short paragraphs.",
      "category": "content",
      "headingLevel": 2,
      "placement": {
        "position": "any",
        "maxPerPage": 3
      },
      "tone": {
        "default": "surface",
        "allowed": ["canvas", "surface"]
      },
      "slots": ["content"],
      "variants": ["photo-start", "photo-end"],
      "props": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "paragraphs", "image"],
        "properties": {
          "variant": {
            "enum": ["photo-start", "photo-end"]
          },
          "eyebrow": {
            "type": "string",
            "maxLength": 40
          },
          "heading": {
            "type": "string",
            "minLength": 3,
            "maxLength": 70
          },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 20,
              "maxLength": 420
            }
          },
          "image": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 60
          },
          "focal": {
            "type": "string",
            "pattern": "^\\d{1,3}% \\d{1,3}%$",
            "maxLength": 9
          }
        }
      },
      "assetProps": ["image"],
      "media": [
        {
          "prop": "image",
          "ratio": "4 / 3",
          "slot": "half-content"
        }
      ],
      "a11y": [
        "The photo has alt text written while looking at it; the text column keeps a 45–75 character measure."
      ],
      "perf": {
        "clientJs": "none"
      },
      "truth": [
        "Dates, names and history come from the business; never a plausible-sounding invented origin story."
      ]
    },
    {
      "id": "hours-location",
      "version": "1.0.0",
      "title": "Hours and location",
      "summary": "Address, opening hours as aligned rows, and a directions link that opens the visitor's own maps app. Use on a home or visit page for any business with a street address. Avoid an embedded map iframe: it is heavy and traps scroll.",
      "category": "location",
      "headingLevel": 2,
      "placement": {
        "position": "any",
        "maxPerPage": 1
      },
      "tone": {
        "default": "canvas",
        "allowed": ["canvas", "surface"]
      },
      "slots": ["content"],
      "props": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading"],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "note": {
            "type": "string",
            "maxLength": 160
          }
        }
      },
      "a11y": [
        "Hours are a description list whose rows share one label column (subgrid), so times align whatever the longest label; the directions link says it opens a map."
      ],
      "perf": {
        "clientJs": "none"
      },
      "truth": [
        "Hours, address and phone come from the business's facts (the manifest's business), never typed into the block."
      ],
      "schemaOrg": [
        "openingHoursSpecification (from the same structured hours the rows are derived from)"
      ]
    },
    {
      "id": "cta-banner",
      "version": "1.0.0",
      "title": "Call to action band",
      "summary": "One short line and one action on an inverse band, to close a page. Use once, near the end. Avoid two in a row, or directly after a hero, which already carries the primary action.",
      "category": "conversion",
      "headingLevel": 2,
      "placement": {
        "position": "any",
        "maxPerPage": 1,
        "notAdjacentTo": ["cta-banner", "hero-full"]
      },
      "tone": {
        "default": "inverse",
        "allowed": ["inverse", "surface"]
      },
      "slots": ["content"],
      "variants": ["book", "call"],
      "props": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "action"],
        "properties": {
          "variant": {
            "enum": ["book", "call"]
          },
          "heading": {
            "type": "string",
            "minLength": 3,
            "maxLength": 48
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "href"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 2,
                "maxLength": 28
              },
              "href": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      },
      "linkProps": ["action.href"],
      "a11y": ["An h2 and one link styled as a button with at least a 44px target."],
      "perf": {
        "clientJs": "none"
      },
      "truth": [
        "The action does what the label says: 'Book' reaches a real booking path, 'Call' a real number."
      ]
    }
  ]
}
