    {
      "id": "price-list",
      "version": "1.0.0",
      "title": "Price list",
      "summary": "A menu or a list of services with prices exactly as charged: a section of a menu, a beer list, a price sheet. Not for offerings without prices (use features-grid), and split a long menu into one block per section.",
      "category": "listing",
      "headingLevel": 2,
      "placement": {
        "position": "any",
        "maxPerPage": 8
      },
      "tone": {
        "default": "canvas",
        "allowed": ["canvas", "surface"]
      },
      "slots": ["content"],
      "props": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "items"],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 3,
            "maxLength": 70
          },
          "intro": {
            "type": "string",
            "maxLength": 220
          },
          "asOf": {
            "description": "The day the prices were last checked against the till; shown under the list.",
            "type": "string",
            "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
            "examples": ["2026-10-01", "2027-03-15"],
            "format": "date"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "price"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 48
                },
                "price": {
                  "description": "As the till rings it, with its currency: $7, 6,50 €, £4.20, Market price.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 14
                },
                "detail": {
                  "description": "One line of facts: 6.8% · 16 oz, 45 min, Serves two.",
                  "type": "string",
                  "maxLength": 48
                },
                "description": {
                  "type": "string",
                  "maxLength": 160
                }
              }
            }
          }
        }
      },
      "a11y": [
        "An h2, then a list (role=list, so VoiceOver keeps it a list); each item's name is an h3, so a long menu can be read by heading. A price never breaks across lines."
      ],
      "perf": {
        "clientJs": "none"
      },
      "truth": [
        "Every price is what the business charges today, as rung up, with its currency; asOf is the day that was checked.",
        "No item the business does not sell, and no price marked down that never was."
      ]
    },
