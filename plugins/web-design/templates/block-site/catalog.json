      ],
      "perf": {
        "clientJs": "none"
      },
      "truth": [
        "Dates, names and history come from the business; never a plausible-sounding invented origin story.",
        "The photo is of this business: its own or commissioned, never stock or generated beside its story."
      ]
    },
    {
      "id": "stats-band",
      "version": "1.0.0",
      "title": "Numbers band",
      "summary": "Two to four numbers that matter to a customer, each with its source. Not for numbers nobody can source, and never more than four.",
      "category": "social-proof",
      "headingLevel": 2,
      "placement": {
        "position": "any",
        "maxPerPage": 1
      },
      "tone": {
        "default": "canvas",
        "allowed": ["canvas", "surface", "inverse"]
