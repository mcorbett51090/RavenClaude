          "title": {
            "type": "string",
            "maxLength": 70,
            "minLength": 3
          },
          "intro": {
            "type": "string",
            "maxLength": 220
          }
        }
      },
      "a11y": ["Renders the page's only h1; the intro is one paragraph at the reading measure."],
      "perf": {
        "clientJs": "none"
      },
      "truth": ["The title names what the page actually holds."]
    },
