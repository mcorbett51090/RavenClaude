        {
          "type": "page-header",
          "props": {
            "eyebrow": "Visit",
            "title": "Find us on Fairhope Avenue",
            "intro": "Walk-ins are welcome every day we are open. Parties of six or more, call ahead and we will push the tables together."
          }
        },
        {
          "type": "hours-location",
          "tone": "surface",
          "props": {
            "heading": "Hours and location",
            "note": "Free street parking on Fairhope Ave, and a public lot behind the building."
