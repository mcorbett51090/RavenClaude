              },
              {
                "question": "Is there parking?",
                "answer": "Free street parking on Fairhope Ave and a public lot behind the building."
              },
              {
                "question": "Do you have high chairs?",
                "answer": "Yes, four, and a changing table in the back restroom."
              }
            ]
          }
        }
      ]
    },
