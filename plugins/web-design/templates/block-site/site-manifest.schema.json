{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site-manifest.schema.json",
  "title": "Site manifest",
  "description": "Everything one site is: its facts, its assets, and each page as an ordered list of blocks with their props. The agent writes this; a renderer turns it into HTML; scripts/block_site_check.py manifest checks it against the catalog first.",
  "type": "object",
  "additionalProperties": false,
  "required": ["siteId", "lang", "business", "assets", "pages"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "siteId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 60
    },
    "lang": {
      "description": "BCP 47 language of the site, used as <html lang>. Hyphenation needs it.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "dir": {
      "description": "Text direction of the site. Left out, it follows the language: rtl for Arabic, Hebrew, Persian, Urdu and the other right-to-left scripts, ltr otherwise. A page's own dir wins.",
      "enum": ["ltr", "rtl"]
    },
    "origin": {
      "description": "Where the site is served, e.g. https://www.example.com. Gives every page a canonical URL and the JSON-LD its url; without it both are left out.",
      "type": "string",
      "pattern": "^https://[a-z0-9.-]+(:[0-9]+)?$",
      "maxLength": 120
    },
    "basePath": {
      "description": "Where under the origin the site is served, e.g. /shop/. Default /. Links in this manifest stay written from the site's root (/visit/); the renderer prefixes every internal link, image and stylesheet with it.",
      "type": "string",
      "pattern": "^/([a-z0-9-]+/)*$",
      "maxLength": 80
    },
    "shareImage": {
      "description": "An asset key: the image a link preview shows (og:image, twitter:card). Needs origin, because a preview needs an absolute URL. A page's own shareImage wins.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "icon": {
      "description": "The site's icon, a file beside the manifest: .svg, .png or .ico. Written as <link rel=icon>.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*[.](svg|png|ico)$",
      "maxLength": 120
    },
    "tier": {
      "description": "Optional: the plan the customer bought, if the catalog maps features to tiers.",
      "type": "string",
      "maxLength": 30
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schemaType"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "schemaType": {
          "description": "schema.org type, e.g. Restaurant, LocalBusiness, Dentist.",
          "type": "string",
          "pattern": "^[A-Z][A-Za-z]+$"
        },
        "phone": {
          "description": "As printed on the page: digits, spaces and + ( ) - . only, then an optional extension ('ext. 12' or 'x12'). Every tel: link must dial it; the renderer's tel: dials the number without the extension, which the page shows. Write a vanity number (1-800-FLOWERS) in digits.",
          "type": "string",
          "maxLength": 30,
          "pattern": "^\\+?\\(?[0-9][0-9 ().-]{4,22}[0-9]( ?(ext\\.?|x) ?[0-9]{1,6})?$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120
        },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["city", "countryCode"],
          "properties": {
            "street": {
              "type": "string",
              "maxLength": 120
            },
            "city": {
              "type": "string",
              "maxLength": 80
            },
            "region": {
              "type": "string",
              "maxLength": 80
            },
            "postalCode": {
              "type": "string",
              "maxLength": 20
            },
            "countryCode": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        },
        "hours": {
          "description": "Structured hours; display rows and the JSON-LD are both derived from them. A day in no entry is closed.",
          "type": "array",
          "maxItems": 14,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["days", "opens", "closes"],
            "properties": {
              "days": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "enum": ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]
                }
              },
              "opens": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "closes": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        },
        "specialHours": {
          "description": "Days that differ from the weekly hours (holidays, events). Rendered under the hours and emitted as specialOpeningHoursSpecification. A past date is warned about, so stale holidays do not linger.",
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "label"],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
              },
              "label": {
                "type": "string",
                "minLength": 2,
                "maxLength": 40
              },
              "closed": {
                "const": true
              },
              "opens": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "closes": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        }
      }
    },
    "chrome": {
      "description": "The site's header and footer, the same on every page. The renderer derives the brand and the footer's facts from business; nav labels are bounded so the header has a worst case to test.",
      "type": "object",
      "additionalProperties": false,
      "required": ["nav"],
      "properties": {
        "menuBelow": {
          "description": "Optional: the header width, in rem, below which the nav becomes a menu. Left out, the renderer estimates it from the labels; device_matrix.mjs measures the real header and prints the value to pin here when the estimate is off (a brand font, another script).",
          "type": "number",
          "minimum": 10,
          "maximum": 200
        },
        "nav": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "href"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 2,
                "maxLength": 20
              },
              "href": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "href"],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 2,
              "maxLength": 28
            },
            "href": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "footerNav": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "href"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 2,
                "maxLength": 20
              },
              "href": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "assets": {
      "description": "Every image, keyed by a lower-case slug that blocks reference. width/height are the source's pixels: they reserve the space (no layout shift) and tell the size check how large the image can be drawn and stay sharp.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "alt", "width", "height", "provenance"],
        "properties": {
          "src": {
            "type": "string",
            "maxLength": 300
          },
          "alt": {
            "description": "Written while looking at the image. \"\" only for a decorative image.",
            "type": "string",
            "maxLength": 200
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "provenance": {
            "enum": ["business-own", "commissioned", "licensed-stock", "generated"]
          },
          "focal": {
            "type": "string",
            "pattern": "^\\d{1,3}% \\d{1,3}%$"
          },
          "credit": {
            "type": "string",
            "maxLength": 120
          },
          "sources": {
            "description": "More widths of the SAME crop, for srcset. The renderer lists them with src, so the browser picks the smallest that stays sharp.",
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["src", "width"],
              "properties": {
                "src": {
                  "type": "string",
                  "maxLength": 300
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "portrait": {
            "description": "Another asset's key: a portrait crop of this photo for narrow portrait screens (art direction). A full-bleed band cover-crops a landscape photo to a sliver on a phone.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 60
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "title", "description", "blocks"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/([a-z0-9-]+/)*$"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "minLength": 50,
            "maxLength": 160
          },
          "lang": {
            "description": "This page's language when it differs from the site's.",
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "dir": {
            "enum": ["ltr", "rtl"]
          },
          "noindex": {
            "description": "Keep the page out of search (stress pages, drafts). Left out of sitemap.xml too.",
            "type": "boolean"
          },
          "shareImage": {
            "description": "This page's link-preview image, an asset key; else the site's.",
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "props"],
              "properties": {
                "type": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "variant": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "maxLength": 40
                },
                "tone": {
                  "enum": ["canvas", "surface", "inverse", "media"]
                },
                "space": {
                  "description": "Section rhythm for this instance. 'none' is not offered here: a block that is designed to abut its neighbour declares it in its contract.",
                  "enum": ["s", "m", "l"]
                },
                "props": {
                  "type": "object"
                },
                "anchor": {
                  "description": "An id for in-page links (href=\"#visit\"). Unique on its page.",
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "maxLength": 40
                }
              }
            }
          }
        }
      }
    },
    "ownerTodos": {
      "description": "Facts nobody could verify. Never rendered; a placeholder in a rendered field is refused instead.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
