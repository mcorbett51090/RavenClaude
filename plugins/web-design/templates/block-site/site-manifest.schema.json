{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site-manifest.schema.json",
  "title": "Site manifest",
  "description": "Everything one site is: its facts, its assets, and each page as an ordered list of blocks with their props. The agent writes this; a renderer turns it into HTML; scripts/block_site_check.py manifest checks it against the catalog first.",
  "type": "object",
  "additionalProperties": false,
  "required": ["siteId", "lang", "business", "assets", "pages"],
  "properties": {
    "$schema": { "type": "string" },
    "siteId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 60 },
    "lang": {
      "description": "BCP 47 language of the site, used as <html lang>. Hyphenation needs it.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "tier": {
      "description": "Optional: the plan the customer bought, if the catalog maps features to tiers.",
      "type": "string",
      "maxLength": 30
    },
    "features": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "uniqueItems": true
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schemaType"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "schemaType": {
          "description": "schema.org type, e.g. Restaurant, LocalBusiness, Dentist.",
          "type": "string",
          "pattern": "^[A-Z][A-Za-z]+$"
        },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["city", "countryCode"],
          "properties": {
            "street": { "type": "string", "maxLength": 120 },
            "city": { "type": "string", "maxLength": 80 },
            "region": { "type": "string", "maxLength": 80 },
            "postalCode": { "type": "string", "maxLength": 20 },
            "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" }
          }
        },
        "hours": {
          "description": "Structured hours; display rows and the JSON-LD are both derived from them. A day in no entry is closed.",
          "type": "array",
          "maxItems": 14,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["days", "opens", "closes"],
            "properties": {
              "days": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": { "enum": ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"] }
              },
              "opens": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "closes": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
            }
          }
        }
      }
    },
    "assets": {
      "description": "Every image, keyed by a lower-case slug that blocks reference. width/height are the source's pixels: they reserve the space (no layout shift) and tell the srcset step how large a candidate can be.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "alt", "width", "height", "provenance"],
        "properties": {
          "src": { "type": "string", "maxLength": 300 },
          "alt": {
            "description": "Written while looking at the image. \"\" only for a decorative image.",
            "type": "string",
            "maxLength": 200
          },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "provenance": { "enum": ["business-own", "commissioned", "licensed-stock", "generated"] },
          "focal": { "type": "string", "pattern": "^\\d{1,3}% \\d{1,3}%$" },
          "credit": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "title", "description", "blocks"],
        "properties": {
          "path": { "type": "string", "pattern": "^/([a-z0-9-]+/)*$" },
          "title": { "type": "string", "minLength": 3, "maxLength": 60 },
          "description": { "type": "string", "minLength": 50, "maxLength": 160 },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "props"],
              "properties": {
                "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "variant": { "type": "string" },
                "tone": { "enum": ["canvas", "surface", "inverse", "media"] },
                "space": { "enum": ["s", "m", "l", "none"] },
                "props": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "ownerTodos": {
      "description": "Facts nobody could verify. Never rendered; a placeholder in a rendered field is refused instead.",
      "type": "array",
      "items": { "type": "string", "maxLength": 300 }
    }
  }
}
