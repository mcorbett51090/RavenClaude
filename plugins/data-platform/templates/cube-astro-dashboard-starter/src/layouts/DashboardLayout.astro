---
import "../styles/globals.css";
interface Props {
  title?: string;
}
const { title = "Dashboard" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="bg-tremor-background-muted text-tremor-content-strong antialiased">
    <slot />
  </body>
</html>
