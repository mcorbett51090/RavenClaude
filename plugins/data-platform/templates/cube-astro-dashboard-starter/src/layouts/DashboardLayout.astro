---
import "../styles/globals.css";
interface Props {
  title?: string;
}
const { title = "Dashboard" } = Astro.props;
const nonce = Astro.locals.cspNonce;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {
      /* is:inline (FORGE dashboard-top1pct P2-18, 2026-09-03) — Astro's
         directive for a script that must run synchronously, un-bundled,
         before hydration; see the Next.js starter's identical script for
         the full rationale. A static, non-interpolated string — no
         request/user data reaches this template. nonce from middleware
         (2026-09-16) so script-src 'nonce-…' allows it without
         'unsafe-inline'. */
    }
    <script is:inline nonce={nonce}>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-tremor-background-muted text-tremor-content-strong antialiased">
    <slot />
  </body>
</html>
