---
// Server-rendered frontmatter: resolves the authenticated tenant BEFORE any
// client JS ships, so an unauthenticated request never reaches the island
// at all. Mirrors the Next.js starter's app/page.tsx server-component
// pattern. getSession() is a documented seam — see src/lib/session.ts.
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { DashboardIsland } from "@/components/DashboardIsland";
import { ThemeToggle } from "@/components/ThemeToggle";
import { Title, Subtitle, Flex } from "@/components/ui";
import { getSession } from "@/lib/session";
import { resolveLocaleContext } from "@/lib/locale";

const session = await getSession();
const { locale, timezone } = resolveLocaleContext(session);
---

<DashboardLayout title="Dashboard">
  <div class="p-6">
    {
      /*
        Title/Subtitle render here, with NO client:* directive — Astro
        renders a framework component with no client directive to static
        HTML at build/request time and ships zero JS for it. Moved out of
        DashboardIsland (found in this plugin's own
        dashboard-architecture-audit dogfood pass, FORGE dashboard-top1pct
        P1-10, 2026-09-03): they're static text with no data dependency, so
        hydrating them alongside the genuinely interactive KPI/chart widgets
        forfeited the zero-JS-by-default value this starter's own README
        argues Astro provides.
      */
    }
    <Flex justifyContent="between" alignItems="start">
      <div>
        <Title>Dashboard</Title>
        <Subtitle>{`Tenant: ${session.tenantId}`}</Subtitle>
      </div>
      {
        /* Its OWN small island, deliberately separate from DashboardIsland
           (FORGE dashboard-top1pct P2-18, 2026-09-03) — Title/Subtitle stay
           static per P1-10's own finding above; the toggle genuinely needs
           client JS (reads/writes localStorage, toggles a DOM class), so it
           gets its own minimal client bundle rather than pulling the static
           text into a hydrated island to sit next to it. */
      }
      <ThemeToggle client:load />
    </Flex>
    <DashboardIsland client:load locale={locale} timezone={timezone} />
  </div>
</DashboardLayout>
