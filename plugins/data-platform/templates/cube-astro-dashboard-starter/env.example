# Copy this to .env (never commit it). Named "env.example" without a
# leading dot — see the Next.js starter's env.example for why.

# Cube instance the browser queries directly (no-iframe pattern). Astro
# exposes only PUBLIC_-prefixed vars to client code — a bare CUBE_API_URL
# here would silently never reach the browser.
PUBLIC_CUBE_API_URL=http://localhost:4000/cubejs-api/v1

# Origin only (scheme+host[:port], no path) of the same Cube instance — used
# server-side by src/middleware.ts to build the CSP connect-src directive.
CUBE_API_ORIGIN=http://localhost:4000

# Host-app JWT signing key — same env var name jwt-issuer.ts expects.
# 32+ random bytes for HS256.
JWT_SIGNING_KEY=
JWT_ISSUER=data-platform-host
JWT_KEY_VERSION=1
