# Copy this to .env.local (never commit .env.local — it's git-ignored by
# Next.js's default .gitignore). Named "env.example" without a leading dot
# so it isn't swept up by tooling that globs dotfile secret patterns.

# Cube instance the browser queries directly (no-iframe pattern — see
# ../../skills/embed-csp-and-iframe-sandboxing/SKILL.md "Cube (with custom
# React UI)"). Must be NEXT_PUBLIC_-prefixed because lib/cube-client.ts reads
# it in client code; a bare CUBE_API_URL here would silently never be read.
NEXT_PUBLIC_CUBE_API_URL=http://localhost:4000/cubejs-api/v1

# The ORIGIN ONLY (scheme+host[:port], no path) of the same Cube instance —
# used server-side by next.config.js to build the CSP connect-src directive.
# Keep in sync with the origin portion of NEXT_PUBLIC_CUBE_API_URL above.
CUBE_API_ORIGIN=http://localhost:4000

# The host-app JWT signing key — same env var name jwt-issuer.ts expects, so
# app/api/cube-token/route.ts can reuse it directly. 32+ random bytes for HS256.
JWT_SIGNING_KEY=
JWT_ISSUER=data-platform-host
JWT_KEY_VERSION=1
