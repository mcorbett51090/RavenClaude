{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rc.spectate.v1",
  "title": "RavenClaude Spectate Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ts",
    "session_id",
    "harness",
    "source",
    "kind",
    "node_id",
    "agent_id"
  ],
  "properties": {
    "schema": { "const": "rc.spectate.v1" },
    "ts": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "harness": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex-cli",
        "copilot-cli",
        "copilot-vscode",
        "cursor",
        "gemini-cli",
        "grok-build",
        "grok-bot",
        "unknown"
      ]
    },
    "source": {
      "type": "string",
      "enum": ["hook", "demo", "steer", "recorded"]
    },
    "kind": {
      "type": "string",
      "enum": [
        "session.start",
        "session.end",
        "prompt.submit",
        "turn.end",
        "tool.pre",
        "tool.post",
        "tool.fail",
        "permission.request",
        "permission.resolve",
        "subagent.start",
        "subagent.stop",
        "compact.pre",
        "steer.applied",
        "stream.truncated",
        "emitter.truncated",
        "step.seed"
      ]
    },
    "step": {
      "type": "string",
      "enum": [
        "assemble",
        "call-model",
        "classify",
        "execute-tools",
        "package",
        "update-context"
      ]
    },
    "node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "parent_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "corr_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "family": {
          "type": "string",
          "enum": ["shell", "url", "path", "other"]
        },
        "target": { "type": "string", "maxLength": 256 }
      }
    },
    "asserted_status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable-harness",
        "denied-org",
        "denied-plugin",
        "denied-user",
        "denied-harness",
        "running",
        "succeeded",
        "failed",
        "waiting-approval",
        "idle"
      ]
    },
    "deny": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string",
          "enum": ["org", "plugin", "user", "harness"]
        },
        "source": { "type": "string", "maxLength": 64 },
        "rule": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:/-]{1,64}$"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": { "type": "number" },
        "out_bytes": { "type": "number" },
        "prompt_chars": { "type": "number" }
      }
    },
    "detail": { "type": "string", "enum": ["minimal", "standard"] },
    "synthetic": { "type": "boolean" }
  }
}
