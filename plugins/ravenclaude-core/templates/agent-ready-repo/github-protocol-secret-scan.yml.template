# github-protocol-secret-scan.yml — scan the PR for committed secrets.
#
# Part of RavenClaude's gold-standard GitHub protocol tier (scaffolded by
# /init-agent-ready). Dogfoods knowledge/github-actions-hardening.md: a deny-all
# top-level permissions floor, and EVERY action pinned to a 40-hex commit SHA
# (actions/checkout AND the third-party scanner), with NO paths/branches filter
# on the pull_request trigger.
#
# NATIVE PUSH PROTECTION (the stronger, Settings-toggle defense this template
# cannot set for you): this workflow scans at PR time, after a secret is already
# committed to a branch. GitHub's native secret-scanning PUSH PROTECTION rejects
# a detected secret at push time, before it ever lands. Enable it under
# Settings -> Code security -> Secret scanning -> Push protection. Treat this
# workflow as defense-in-depth beside that toggle, not a replacement for it.
#
# MANUAL DISPATCH: on a `workflow_dispatch` run there is no PR, so
# github.event.pull_request.base/head are EMPTY and a diff-scoped scan has no range.
# The scan step is gated to `pull_request` only and skipped cleanly (with a printed
# note) on any other event — mirroring github-protocol-commit-lint.yml. A
# would-be-required check must still SUCCEED on dispatch, so the job stays green.
#
# CONSUMER: verify each pinned SHA is current for your adoption date (look up the
# scanner's latest release commit and re-pin); keep any would-be-required trigger
# path-filter-free.
name: GitHub protocol — secret scan

on:
  pull_request:
  workflow_dispatch:

permissions: {}

jobs:
  secret-scan:
    name: Scan for committed secrets (TruffleHog)
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0

      # Diff-scoped scan — PR events only (base/head are populated there). On a
      # manual dispatch base/head are empty, so this step is skipped (see below).
      - name: TruffleHog secret scan (PR diff)
        if: github.event_name == 'pull_request'
        uses: trufflesecurity/trufflehog@6f3c981e7b77f235fd2702dd74af25fc4b72bf11 # v3.96.0
        with:
          base: ${{ github.event.pull_request.base.sha }}
          head: ${{ github.event.pull_request.head.sha }}
          extra_args: --results=verified,unknown

      # Non-PR event (workflow_dispatch): no base/head range to diff. Skip cleanly
      # with a note so a would-be-required check still succeeds — mirrors commit-lint.
      - name: Not a pull_request event — nothing to diff-scan
        if: github.event_name != 'pull_request'
        run: echo "Not a pull_request event (base/head empty) — diff-scoped secret scan skipped."
