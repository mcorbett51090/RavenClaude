#!/usr/bin/env bash
# rc — RavenClaude front-door dispatcher.
#
# The single command consumers (and Copilot/Claude on their behalf) run instead
# of remembering python invocations. Verbs:
#
#   rc dashboard [--port N] [--no-open]   Launch the comfort-posture dashboard.
#   rc streams <subcommand>               Inspect / manage Agentic Work-Streams.
#   rc converge <subcommand>              Convergence Engine (refine-to-rubric) helpers.
#
# DESIGN — why this never `cd`s:
#   serve-dashboards.py resolves the project root from `Path.cwd()`, so
#   `.ravenclaude/comfort-posture.yaml` (and everything Save & apply writes) lands
#   in whatever directory you ran `rc` from — your project, not the plugin. The
#   launcher therefore preserves the caller's cwd and only resolves the *script*
#   path relative to itself, so it works from any clone location and any host
#   (Claude Code, Copilot CLI, a bare terminal).
#
# GETTING `rc` ON YOUR PATH (optional — Copilot/Claude can run it by full path):
#   export PATH="$PATH:<your-ravenclaude-clone>/plugins/ravenclaude-core/bin"
#   Then `rc dashboard` works from any directory. Without it, run it by path:
#   bash <clone>/plugins/ravenclaude-core/bin/rc dashboard

set -euo pipefail

# Resolve this script's own directory (follow one symlink level for PATH installs).
_src="${BASH_SOURCE[0]}"
[ -L "$_src" ] && _src="$(readlink "$_src")"
BIN_DIR="$(cd "$(dirname "$_src")" && pwd)"
PLUGIN_ROOT="$(cd "$BIN_DIR/.." && pwd)"

_usage() {
  cat >&2 <<EOF
rc — RavenClaude front door

Usage:
  rc dashboard [--port N] [--no-open]   Launch the comfort-posture dashboard (local server).
                                        Run it from your project root so .ravenclaude/ is
                                        written there. Prints the URL it binds.

  rc probe http <url> | dns <host> | file <path> | cmd <name>
                                        Probe a thing AND a known-good CONTROL on the same
                                        subsystem, so a negative result can be told apart from
                                        a probe that was never capable of succeeding.
                                        A 404 is not a diagnosis until a control has passed.
  rc probe --explain                    What a negative result does and does NOT license.

  rc streams [list]                     List logical work-streams in this project (default).

  rc artifacts list|new <id>   where work files go, across CLIs
  rc handoff --task-id <id> [--dry-run] [--host claude-code|grok|cli|chat|other]
                                        [--recipe copy-paste|same-host|os-terminal]
                                        Print (and optionally spawn) a same-host
                                        successor from a run-dir handoff.md.
  rc forge-worktree init|checkpoint|path|--self-test
                                        FORGE worktree provisioner (plugin scripts/).
  rc forge-route --plan PATH | --self-test
                                        FORGE G7 router.
  rc premise-gate --run-dir DIR | --self-test | --must-fail
                                        FORGE G3b premise gate.
  rc classify-claim --text "…"          Grammatical claim classifier (upward-only).
  rc streams show <id> [--limit N]      Show a stream's resume state + recent DERIVED history.
  rc streams status                     One-line summary: active stream + stream count.
  rc streams create <name>              Create a named stream (slugified).
  rc streams set-active <id>            Point the active-stream pointer at <id>.
  rc streams get-active                 Print the active stream id (or "none").

  rc converge report <scorecard.json>            Render the constrained convergence report
                                                 (verdict + keep-best + honest residual gaps).
                                                 NEVER prints "perfect".
  rc converge verdict --rubric R --scorecard S   Print the deterministic terminate() verdict JSON
                                                 (exit 0 = stop reached, 1 = keep refining).
  rc converge derive --kind K [--explicit "..."] Derive a rubric for an artifact kind from the
                                                 externalized library (prints rubric JSON).

Notes:
  - The dashboard is a small LOCAL server bound to 127.0.0.1 — single-user, no auth.
  - In a Codespace the forwarded port opens automatically; open it in a REAL browser
    tab (not VS Code Simple Browser) and keep the port Private (Save writes files).
  - 'rc streams' reads/writes .ravenclaude/streams/ in the directory you run it from.
    The per-stream history stores DERIVED labels only — never raw prompt text.
EOF
}

cmd="${1:-}"
case "$cmd" in
  probe)
    shift
    # The control-probe kit. A negative result is not a diagnosis until a
    # positive-capable probe on the SAME subsystem has been observed — otherwise
    # you cannot tell "the subject is broken" from "I probed the wrong thing."
    # 2026-08-08: a 404 on an href PLACEHOLDER (supposed to 404) produced an
    # 85-line component, 10 converted call sites and two turns of owner-facing
    # architectural advice. One control probe would have cost ten seconds.
    # ⛔ THE PLUGIN COPY IS TRIED FIRST, AND IT IS THE ONE THAT SHIPS.
    # Until 0.241.0 the engine lived ONLY at the marketplace root's scripts/,
    # which is not part of the distributed plugin — so from an installed cache
    # `rc probe` found nothing and the whole control-probe feature was dead for
    # every consumer, while the probe-kit SKILL shipped and told them to run it.
    # It now lives in the plugin's bin/ (beside this launcher) so it travels with
    # the install. The marketplace-root path is kept last, for a dev checkout
    # that still has one.
    #
    # bin/ rather than scripts/ on purpose: probe-kit is a tool a human or agent
    # INVOKES, like this launcher — not one of the Thing's engines. The plugin's
    # scripts/ is the tribunal's own substrate and is write-guarded, so parking a
    # general-purpose tool there would make every future edit fight that guard.
    kit="$PLUGIN_ROOT/bin/probe-kit.sh"
    [ -f "$kit" ] || kit="$PLUGIN_ROOT/scripts/probe-kit.sh"
    [ -f "$kit" ] || kit="$PLUGIN_ROOT/../../scripts/probe-kit.sh"
    if [ ! -f "$kit" ]; then
      # ⛔ EXIT 1, NOT 0. This used to exit 0, so a caller written as
      # `rc probe … || fallback` took the SUCCESS branch having probed nothing —
      # a control-runner that fails OPEN is worse than none, because the session
      # believes it ran a control.
      echo "rc: cannot find probe-kit.sh (looked in the plugin bin/, scripts/, and beside the marketplace root)" >&2
      exit 1
    fi
    exec bash "$kit" "$@"
    ;;
  dashboard)
    shift
    server="$PLUGIN_ROOT/scripts/serve-dashboards.py"
    if [ ! -f "$server" ]; then
      echo "rc: cannot find serve-dashboards.py at $server" >&2
      exit 1
    fi
    command -v python3 >/dev/null 2>&1 || {
      echo "rc: python3 not found in PATH — the dashboard server needs python3." >&2
      exit 1
    }
    # exec (no cd): replace this process so Ctrl+C stops the server cleanly, and
    # the server inherits the caller's cwd as the project root.
    exec python3 "$server" "$@"
    ;;
  streams)
    shift
    ops="$PLUGIN_ROOT/scripts/stream-ops.py"
    if [ ! -f "$ops" ]; then
      echo "rc: cannot find stream-ops.py at $ops" >&2
      exit 1
    fi
    command -v python3 >/dev/null 2>&1 || {
      echo "rc: python3 not found in PATH — 'rc streams' needs python3." >&2
      exit 1
    }
    # The store lives under the caller's cwd (no cd), matching the dashboard rule:
    # .ravenclaude/streams/ belongs to YOUR project, not the plugin clone.
    sub="${1:-list}"
    case "$sub" in
      status)
        # Read-only one-line summary built from the JSON list (no extra surface).
        python3 - "$ops" "$PWD" <<'PY'
import importlib.util, json, sys
ops_path, root = sys.argv[1], sys.argv[2]
spec = importlib.util.spec_from_file_location("stream_ops", ops_path)
m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
streams = m.list_streams(root)
active = m.read_active(root)
print(f"streams: {len(streams)} | active: {active or 'none'}")
for s in streams:
    mark = "*" if s["active"] else " "
    print(f"  {mark} {s['id']:<28} {s['event_count']:>4} events  {s['name']}")
PY
        ;;
      list)
        shift || true
        python3 - "$ops" "$PWD" <<'PY'
import importlib.util, sys
ops_path, root = sys.argv[1], sys.argv[2]
spec = importlib.util.spec_from_file_location("stream_ops", ops_path)
m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
streams = m.list_streams(root)
if not streams:
    print("No streams yet. Create one with: rc streams create \"<name>\"")
else:
    active = m.read_active(root)
    print(f"Work-streams ({len(streams)})  [active: {active or 'none'}]")
    for s in streams:
        mark = "* " if s["active"] else "  "
        print(f"{mark}{s['id']:<28} {s['event_count']:>4} events  {s['name']}")
PY
        ;;
      show | create | set-active | get-active)
        # Delegate straight to the ops CLI (it prints JSON / friendly status).
        exec python3 "$ops" --root "$PWD" "$@"
        ;;
      -h | --help | help)
        _usage
        exit 0
        ;;
    
  *)
        echo "rc streams: unknown subcommand '$sub'" >&2
        _usage
        exit 1
        ;;
    esac
    ;;
  converge)
    shift
    cdir="$PLUGIN_ROOT/skills/refine-to-rubric/scripts"
    command -v python3 >/dev/null 2>&1 || {
      echo "rc: python3 not found in PATH — 'rc converge' needs python3." >&2
      exit 1
    }
    sub="${1:-help}"
    case "$sub" in
      report)
        shift || true
        sc="${1:-}"
        [ -z "$sc" ] && { echo "rc converge report: needs a scorecard JSON path" >&2; exit 1; }
        loop="$cdir/loop.py"
        [ -f "$loop" ] || { echo "rc: cannot find loop.py at $loop" >&2; exit 1; }
        exec python3 "$loop" --scorecard "$sc"
        ;;
      verdict)
        shift || true
        conv="$cdir/converge.py"
        [ -f "$conv" ] || { echo "rc: cannot find converge.py at $conv" >&2; exit 1; }
        # converge.py owns its --rubric/--scorecard/--emit-verdict args; default to emitting.
        exec python3 "$conv" --emit-verdict "$@"
        ;;
      derive)
        shift || true
        der="$cdir/derive_rubric.py"
        [ -f "$der" ] || { echo "rc: cannot find derive_rubric.py at $der" >&2; exit 1; }
        exec python3 "$der" "$@"
        ;;
      -h | --help | help)
        _usage
        exit 0
        ;;
      *)
        echo "rc converge: unknown subcommand '$sub' (try: report | verdict | derive)" >&2
        _usage
        exit 1
        ;;
    esac
    ;;
  "" | -h | --help | help)
    _usage
    # No verb is an error (so scripts catch it); explicit help is a success.
    [ -z "$cmd" ] && exit 1 || exit 0
    ;;
  forge-worktree)
    shift
    exec bash "$PLUGIN_ROOT/scripts/forge-worktree.sh" "$@"
    ;;
  forge-route)
    shift
    command -v python3 >/dev/null 2>&1 || {
      echo "rc: python3 not found in PATH — 'rc forge-route' needs python3." >&2
      exit 1
    }
    exec python3 "$PLUGIN_ROOT/scripts/forge-route.py" "$@"
    ;;
  premise-gate)
    shift
    command -v python3 >/dev/null 2>&1 || {
      echo "rc: python3 not found in PATH — 'rc premise-gate' needs python3." >&2
      exit 1
    }
    exec python3 "$PLUGIN_ROOT/scripts/premise-gate.py" "$@"
    ;;
  classify-claim)
    shift
    command -v python3 >/dev/null 2>&1 || {
      echo "rc: python3 not found in PATH — 'rc classify-claim' needs python3." >&2
      exit 1
    }
    exec python3 "$PLUGIN_ROOT/scripts/classify_claim.py" "$@"
    ;;
  ledger)
    shift
    command -v python3 >/dev/null 2>&1 || {
      echo "rc: python3 not found in PATH — 'rc ledger' needs python3." >&2
      exit 1
    }
    exec python3 "$PLUGIN_ROOT/scripts/ledger.py" "$@"
    ;;
  set-conservation)
    shift
    command -v python3 >/dev/null 2>&1 || {
      echo "rc: python3 not found in PATH — 'rc set-conservation' needs python3." >&2
      exit 1
    }
    exec python3 "$PLUGIN_ROOT/scripts/set_conservation.py" "$@"
    ;;
  handoff)
    shift
    exec bash "$PLUGIN_ROOT/scripts/handoff-spawn.sh" "$@"
    ;;
  artifacts)
    shift
    # The cross-CLI work-file index. Lives at the MARKETPLACE root scripts/ (not
    # the plugin's) because it is a repo-organisation tool like the generators,
    # not a plugin runtime component. bin/rc sits inside the clone, so the root
    # is two levels up from the plugin.
    market="$(cd "$PLUGIN_ROOT/../.." && pwd)"
    art="$market/scripts/rc-artifacts.py"
    if [ ! -f "$art" ]; then
      echo "rc: cannot find rc-artifacts.py at $art" >&2
      exit 1
    fi
    command -v python3 >/dev/null 2>&1 || {
      echo "rc: python3 not found in PATH — 'rc artifacts' needs python3." >&2
      exit 1
    }
    # NO cd: work directories belong to YOUR project, resolved from the caller's
    # cwd, exactly like `rc dashboard` and `rc streams`.
    exec python3 "$art" "$@"
    ;;

  *)
    echo "rc: unknown command '$cmd' (try: rc dashboard | rc streams | rc converge | rc artifacts | rc handoff | rc forge-worktree | rc forge-route | rc premise-gate | rc classify-claim)" >&2
    _usage
    exit 1
    ;;
esac
