{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas/lever.schema.json",
  "title": "Lever record, keyed by surface, lever and model",
  "description": "Where a lever physically lives. A lever the product does not expose is itself a record (vendor_managed or not_applicable, with a positive quote). No numeric confidence field exists anywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": ["surface", "lever", "row", "location_kind", "state", "verification", "evidence"],
  "properties": {
    "surface": {
      "enum": [
        "claude-code",
        "codex-cli",
        "copilot-cli",
        "copilot-vscode",
        "cursor",
        "gemini-cli",
        "grok-build",
        "grok-bot"
      ]
    },
    "lever": { "enum": ["model", "effort", "mode", "parallelism", "other"] },
    "row": { "type": "string", "pattern": "^F[0-9]{2}\\.[a-z0-9-]+$" },
    "model": {
      "type": ["string", "null"],
      "description": "The model this record is valid for, or null when it applies to all."
    },
    "location_kind": {
      "enum": [
        "cli_flag",
        "settings_key",
        "config_file_key",
        "env_var",
        "frontmatter_field",
        "per_dispatch_param",
        "slash_command",
        "ui_picker",
        "api_param",
        "vendor_managed",
        "not_applicable",
        "undocumented"
      ]
    },
    "literal": {
      "type": "string",
      "description": "The exact flag, key, variable or field name, as written by the vendor."
    },
    "scope": { "type": "string" },
    "precedence": { "type": "string", "description": "Only if a source states it." },
    "values": { "type": "array", "items": { "type": "string" } },
    "default": { "type": "string" },
    "values_by_model": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "model_conditional": { "type": "boolean" },
    "state": { "enum": ["supported", "partial", "not-exposed", "not-applicable", "undocumented"] },
    "verification": { "enum": ["verified", "unverified"] },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "pattern": "^E-[a-z0-9-]+-[0-9]{5}$" }
    },
    "unread_models": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Models whose levels were not read; each renders as [unverified]."
    }
  }
}
