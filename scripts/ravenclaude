#!/usr/bin/env bash
# ravenclaude — install / update the RavenClaude plugins for GitHub Copilot CLI.
#
# The frictionless answer to "Copilot's plugin-update method is intolerable": we
# DON'T use Copilot's install-and-cache mechanism. Everything Copilot reads is a
# LIVE-from-disk surface, so an update is just `git pull` + a re-materialize:
#
#   * the plugin is loaded with `copilot --plugin-dir <marketplace>/plugins/ravenclaude-core/copilot`
#     (live from the directory — never installed/cached)
#   * skills live in <project>/.claude/skills      (Copilot reads .claude/skills live)
#   * hooks live in <project>/.github/hooks         (Copilot reads repo hooks live; also the
#                                                    #2540 workaround — plugin-level hooks don't fire)
#   * MCP servers are written to ~/.copilot/mcp-config.json
#
# Subcommands:
#   ravenclaude setup [--project DIR]     one-shot: install + seed & apply a balanced
#                                         comfort-posture + add an `rc` launch alias
#   ravenclaude install [--project DIR]   one-time wiring into a project (default: $PWD)
#   ravenclaude update                    git pull the marketplace + regenerate the Copilot package
#   ravenclaude status [--project DIR]    show what is wired
#   ravenclaude dashboard [--project DIR] [--port N]
#                                         open the comfort-posture dashboard scoped to a repo
#   ravenclaude init-codespace [--project DIR]
#                                         stamp the Codespace auto-setup .devcontainer/ into a repo
#
# Re-running any subcommand is safe (idempotent). After `update`, run `/skills reload`
# in your Copilot session (or relaunch) to pick up changes — no re-install ever.

set -euo pipefail

# The marketplace checkout = the repo this script lives in.
MARKET="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COPILOT_PKG="$MARKET/plugins/ravenclaude-core/copilot"
CORE="$MARKET/plugins/ravenclaude-core"
SKILLS_SRC="$CORE/skills"
GEN="$MARKET/scripts/generate-copilot-plugin.py"
CODEX_SHIM="$CORE/hooks/codex-hook-env.sh"

note() { printf '  %s\n' "$*"; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!\033[0m %s\n' "$*" >&2; }

# detect_host — which agentic CLI is this install for? (multi-host audit MH-07)
#
# BACKWARD-COMPATIBILITY INVARIANT: when the answer is at all ambiguous this
# returns `copilot`, the historical and only prior behaviour. An existing user who
# happens to have `codex` on PATH must not silently get a different install than
# they got yesterday — so Codex is chosen ONLY when it is the sole host present,
# and even then `--host` overrides. Detection reports; it never surprises.
detect_host() {
  local have_codex=0 have_copilot=0
  command -v codex   >/dev/null 2>&1 && have_codex=1
  command -v copilot >/dev/null 2>&1 && have_copilot=1
  if [ "$have_codex" -eq 1 ] && [ "$have_copilot" -eq 0 ]; then
    printf 'codex\n'; return 0
  fi
  printf 'copilot\n'
}

# copilot_version_check — warn when the running Copilot CLI is below the floor
# where this repo's guardrails actually fire (multi-host audit MH-23).
#
# THE FLOOR IS 1.0.52, and it is a SAFETY floor, quoted verbatim from
# https://github.com/github/copilot-cli/blob/main/changelog.md (retrieved 2026-07-28):
#
#   1.0.52 (2026-05-23) — "Hooks (preToolUse, postToolUse, subagentStart,
#   subagentStop) now fire correctly for sub-agent tool…"
#
# Below it, a SUB-AGENT's tool calls are not hooked at all — so a subagent runs
# Bash straight past the tribunal, guard-destructive, the runaway brake and the
# layout gate, silently, while `install` reports success. Same silent-disarm shape
# as Codex's hash-trust (MH-17), on the flagship non-Claude host, and until now
# nothing anywhere checked it.
#
# 1.0.57 is the RECOMMENDED line ("Plugins auto-installed from repository settings
# no longer leak into user global config") — hygiene, not safety, so it is a note.
#
# WHY THIS ONLY WARNS: every host-condition guard in this repo is fail-safe. An
# install that works for everything except sub-agent hook coverage is still worth
# completing; a hard block would strand users whose setup is otherwise fine. And
# `copilot` absent / unparseable version / no `sort -V` all degrade to a note —
# never a failed install, never a false "you are fine".
COPILOT_FLOOR="1.0.52"
COPILOT_RECOMMENDED="1.0.57"

copilot_version_check() {
  command -v copilot >/dev/null 2>&1 || {
    note "copilot not on PATH — version floor unverified (need >= $COPILOT_FLOOR)"
    return 0
  }
  local raw ver
  # `|| true` ON BOTH PIPELINES IS LOAD-BEARING — do not "clean it up".
  # This script runs under `set -euo pipefail`. A `copilot` that exits non-zero,
  # or a `grep` that matches nothing (i.e. any unparseable version string), makes
  # the pipeline non-zero, which under `pipefail` propagates to the assignment and
  # under `set -e` ABORTS `ravenclaude status`/`install` outright. Verified: without
  # these, a copilot printing unparseable output exited 1 and truncated the whole
  # command. A version check that kills the installer is strictly worse than no
  # version check — it is the same fail-in-the-dangerous-direction defect this
  # whole audit exists to close, committed by the guard against it.
  raw="$(copilot --version 2>/dev/null | head -1 || true)"
  # First dotted triple anywhere in the output; tolerant of "copilot version X" etc.
  ver="$(printf '%s' "$raw" | tr -c '0-9.\n' ' ' | tr ' ' '\n' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | head -1 || true)"
  if [ -z "$ver" ]; then
    note "could not parse a version from 'copilot --version' — floor unverified (need >= $COPILOT_FLOOR)"
    return 0
  fi
  # Pure-sort comparison: the LOWEST of {ver, floor} equals floor  =>  ver >= floor.
  local lowest
  lowest="$(printf '%s\n%s\n' "$ver" "$COPILOT_FLOOR" | sort -V 2>/dev/null | head -1)" || lowest=""
  if [ -z "$lowest" ]; then
    note "no 'sort -V' available — Copilot version $ver not compared against $COPILOT_FLOOR"
    return 0
  fi
  if [ "$ver" != "$COPILOT_FLOOR" ] && [ "$lowest" = "$ver" ]; then
    warn "Copilot CLI $ver is BELOW $COPILOT_FLOOR — sub-agent tool calls are NOT hooked."
    note "  A sub-agent can run Bash past every guardrail wired here, silently."
    note "  Fix: update Copilot CLI. Source: github/copilot-cli changelog, 1.0.52."
    return 0
  fi
  lowest="$(printf '%s\n%s\n' "$ver" "$COPILOT_RECOMMENDED" | sort -V | head -1)"
  if [ "$ver" != "$COPILOT_RECOMMENDED" ] && [ "$lowest" = "$ver" ]; then
    note "copilot $ver — meets the $COPILOT_FLOOR safety floor; $COPILOT_RECOMMENDED recommended (repo plugin settings can leak into global config below it)"
  else
    ok "copilot $ver — meets the $COPILOT_FLOOR safety floor"
  fi
}

# wire_cursor <project> — the Cursor lane (multi-host audit MH-13 + MH-25).
#
# Cursor had ZERO in-loop enforcement before this: not the layout gate, not
# guard-destructive, not the command-review tribunal, not the runaway brake. CI was
# the only backstop, and CI runs after the damage.
#
# TWO SURFACES, because Cursor has two and the repo served neither:
#   .cursor/hooks.json   — guardrails, PROJECTED from the canonical manifest
#   .cursor/rules/*.mdc  — Cursor's OWN rules convention, which its docs call the
#                          scoped alternative to AGENTS.md (not a superset)
#
# ⚠ CURSOR FAILS OPEN — a malformed hook response silently ALLOWS the command
# (verified against Cursor's bug tracker). Every other host here fails closed. The
# adapter's deny verdict is therefore a fixed literal; see its header.
wire_cursor() {
  local project="$1"
  local gen="$MARKET/scripts/generate-cursor-hooks.py"
  local adapter="$CORE/hooks/cursor-hook-adapter.sh"
  mkdir -p "$project/.cursor/rules"
  if [ -f "$gen" ]; then
    python3 "$gen" --adapter "$adapter" --hooks-dir "$CORE/hooks" \
      --out "$project/.cursor/hooks.json" \
      && ok "wired guardrails into .cursor/hooks.json (projected from the manifest)" \
      || warn "cursor hook projection FAILED — no guardrails wired for this project"
  else
    warn "generate-cursor-hooks.py missing — Cursor guardrails NOT wired"
  fi

  # Rule 1 — the always-on discipline pointer.
  cat >"$project/.cursor/rules/ravenclaude.mdc" <<'MDC'
---
description: RavenClaude cross-tool agent discipline for this repository.
alwaysApply: true
---

Read `AGENTS.md` at the repository root end-to-end before making changes. It is the
canonical cross-tool guidance: testing instructions, the layout allow-list
discipline, and the PR conventions.

Guardrails that DO run for you here: shell commands are screened in-loop via
`.cursor/hooks.json` (`beforeShellExecution`). A blocked command returns
`permission: deny` — do not retry it verbatim; adjust the command to satisfy the
guard, or ask the user.

Guardrails that DO NOT run for you here: the file-path layout gate and the
web-access guard have no verified Cursor enforcement event. **CI is the backstop
for those** — a write to a path outside `.repo-layout.json` `allowed_globs` will
fail the build even though nothing stops it locally.
MDC

  # Rule 2 — the layout allow-list, GLOB-SCOPED. This is the rule .mdc globs exist
  # for, and the reason serving only AGENTS.md shortchanged Cursor users: a flat
  # always-on file cannot express "this applies when you touch these paths".
  python3 - "$project/.cursor/rules/repo-layout.mdc" "$MARKET/.repo-layout.json" <<'PY2'
import json, sys
out, layout = sys.argv[1], sys.argv[2]
try:
    globs = json.load(open(layout)).get("allowed_globs", [])
except Exception:
    globs = []
sample = ", ".join(globs[:12])
body = f"""---
description: Layout allow-list — every new file path must match .repo-layout.json.
globs: ["**/*"]
alwaysApply: false
---

Before creating a NEW file, confirm its path matches at least one glob in
`.repo-layout.json` `allowed_globs`. CI (`validate-layout.yml`) fails the build on
any added file that does not, and under Cursor **nothing stops it locally** — the
path guard has no verified Cursor enforcement event, so this rule is the only
warning you get before CI.

Current allow-list ({len(globs)} globs; first few): {sample}

Read the file itself for the authoritative list; this rule is generated and may lag.
"""
open(out, "w").write(body)
PY2
  ok "wired 2 Cursor rules into .cursor/rules/*.mdc (incl. the glob-scoped layout rule)"
  note "NOT enforced under Cursor: the layout gate and web-access guard have no"
  note "  verified enforcement event there. CI is the backstop; the rules say so."
  note "⚠ Cursor FAILS OPEN on a malformed hook response — do not hand-edit"
  note "  .cursor/hooks.json; re-run this installer instead."
}

# wire_codex_skills <project> <plugin-name>
#
# Codex discovers skills from `.agents/skills` in EVERY directory from the cwd up
# to the repo root, then $HOME/.agents/skills, then /etc/codex/skills, then bundled
# `[docs-verified 2026-07-28 — learn.chatgpt.com/docs/build-skills]`.
#
# NOT `.claude/skills` — that is Copilot's (and Claude's) read path, and wiring a
# Codex user there is exactly how `ravenclaude setup` came to complete
# "successfully" while wiring zero skills into their host (MH-07).
#
# WATCH OUT: several third-party guides claim Codex reads `.codex/skills`. The
# primary source says `.agents/skills`. knowledge/host-support.json records this
# and warns off the blogs; do not "fix" this path from a blog post.
#
# Repo-local is the deliberate default (team-shareable, travels with the project).
# The SKILL.md shape is identical to .claude/skills, so the same 50 skills project
# across untouched — no per-host rewriting.
wire_codex_skills() {
  local project="$1" plugin_name="$2"
  local skills_src="$MARKET/plugins/$plugin_name/skills"
  if [ ! -d "$skills_src" ]; then
    warn "plugin '$plugin_name' has no skills/ directory (looked at $skills_src) — skipped"
    echo 0; return 0
  fi
  mkdir -p "$project/.agents/skills"
  local n=0
  for d in "$skills_src"/*/; do
    [ -d "$d" ] || continue
    local name; name="$(basename "$d")"
    local dest="$project/.agents/skills/$name"
    rm -rf "$dest"
    ln -s "$d" "$dest" 2>/dev/null || cp -r "$d" "$dest"
    n=$((n + 1))
  done
  echo "$n"
}

# wire_codex_hooks <project>
#
# Writes <project>/.codex/hooks.json in the CLAUDE-SHAPED schema — because that is
# literally what Codex reads. Codex speaks the Claude hook contract natively:
# identical PascalCase events, identical stdin field names, identical `exit 2`
# blocking, identical tool-name VALUES ("Bash", not Copilot's "bash")
# `[docs-verified 2026-07-28 — learn.chatgpt.com/docs/hooks]`.
#
# SO THERE IS NO ADAPTER HERE, AND THERE MUST NOT BE ONE. Copilot needed a 456-line
# generator plus ~300 lines of envelope translation and a tool-name normalisation
# map. Building the same for Codex would be the expensive wrong answer, and the
# mis-scoping that came from reading Codex through Copilot's model is the root
# cause this whole audit traced (MH-15).
#
# The ONE thing that genuinely differs is two absent environment variables, which
# hooks/codex-hook-env.sh lifts out of the stdin payload. See that file's header.
#
# Invoked as `bash "<shim>"` rather than executing the shim directly: the wiring
# then survives a checkout that lost its exec bits (Windows, some zip exports, a
# `cp -r` install fallback), which this installer already defends against for
# skills.
wire_codex_hooks() {
  local project="$1"
  mkdir -p "$project/.codex"
  python3 - "$project/.codex/hooks.json" "$CODEX_SHIM" "$CORE" <<'PY'
import json, sys
out, shim, core = sys.argv[1], sys.argv[2], sys.argv[3]
h = core + "/hooks"

def cmd(script, arg=""):
    # bash "<shim>" "<real hook>" [arg] — the shim lifts cwd/session_id from stdin
    # into CLAUDE_PROJECT_DIR/CLAUDE_SESSION_ID, then passes stdin through byte-
    # identical and propagates the hook's exit code verbatim (exit 2 = block).
    tail = f' {arg}' if arg else ""
    return {"type": "command", "command": f'bash "{shim}" "{h}/{script}"{tail}'}

cfg = {
    "$schema": "https://json.schemastore.org/claude-code-hooks.json",
    "description": (
        "RavenClaude guardrails for OpenAI Codex CLI. GENERATED by "
        "`ravenclaude install --host codex` — do not hand-edit; re-run the installer. "
        "Paths are absolute into the marketplace checkout so `git pull` updates "
        "behaviour live. NOTE: Codex tracks hook trust BY HASH, so any change to a "
        "hook script marks it for review and SKIPS it until you re-trust via /hooks."
    ),
    "hooks": {
        "SessionStart": [
            {"hooks": [cmd("capability-orientation.sh"),
                       cmd("thing-denial-kb-recall.sh")]}
        ],
        "PreToolUse": [
            {"matcher": "Bash",
             "hooks": [cmd("guard-destructive.sh"),
                       cmd("thing-orchestrator.sh"),
                       cmd("runaway-brake.sh")]},
            {"matcher": "Edit|Write|MultiEdit",
             "hooks": [cmd("enforce-layout.sh")]},
            {"matcher": "WebFetch",
             "hooks": [cmd("guard-web-access.sh")]},
        ],
        "PostToolUse": [
            {"matcher": "Edit|Write|MultiEdit",
             "hooks": [cmd("format-on-write.sh", '"$CLAUDE_TOOL_FILE_PATH"'),
                       cmd("claim-grounding-lint.sh", '"$CLAUDE_TOOL_FILE_PATH"')]}
        ],
        "Stop": [
            {"hooks": [cmd("dod-gate.sh"),
                       cmd("remind-tests.sh"),
                       cmd("stream-session-close.sh")]}
        ],
    },
}
open(out, "w").write(json.dumps(cfg, indent=2) + "\n")
PY
}

# codex_hook_count — how many hook scripts the Codex wiring references.
# Used by the MH-17 re-trust notice; counts entries in the generated file so the
# number can never drift from what was actually wired.
codex_hook_count() {
  local f="$1"
  [ -f "$f" ] || { echo 0; return 0; }
  python3 - "$f" <<'PY' 2>/dev/null || echo 0
import json, sys
d = json.load(open(sys.argv[1]))
print(sum(len(g.get("hooks", [])) for ev in d.get("hooks", {}).values() for g in ev))
PY
}

# codex_retrust_notice <project>
#
# MH-17 — the P1 that MUST ship with the installer, not after it.
#
# Codex records hook trust against each hook's HASH: "new or changed hooks are
# marked for review and skipped until trusted" `[docs-verified 2026-07-28]`. This
# repo's headline update pillar is "an update is just `git pull` — no re-install,
# ever." On Codex those two facts multiply into a SILENT DISARM: every pull that
# changes a byte of any hook invalidates its hash, and that guardrail stops running
# until a human notices.
#
# And nothing will tell them — because the SessionStart banner that would have
# announced it IS ITSELF A HOOK, so it is skipped by the same mechanism. Given ~18
# hooks and near-weekly bumps, the steady state for an un-warned Codex consumer is
# guardrails quietly off after every update.
#
# Shipping the installer without this notice would have manufactured exactly the
# silently-inert-guardrail class this entire audit exists to close.
#
# We deliberately do NOT name `--dangerously-bypass-hook-trust` as the fix. Turning
# off the trust check to make trust convenient is governance theatre, and the
# onboarding skill lists that anti-pattern by name.
codex_retrust_notice() {
  local project="$1"
  local n; n="$(codex_hook_count "$project/.codex/hooks.json")"
  printf '\n'
  warn "Codex trusts hooks BY HASH — re-trust after every update."
  note "Run /hooks inside Codex and trust the $n RavenClaude hook(s)."
  note "Until you do, they are SKIPPED — and no banner will say so, because the"
  note "SessionStart banner is itself a hook. Re-run /hooks after every 'git pull'."
  note "For teams: Codex's requirements.toml managed-hooks path auto-trusts by"
  note "policy and is the only configuration where these survive an update"
  note "unattended. Do NOT reach for --dangerously-bypass-hook-trust."
}

# Install the one-word `rc` launcher into ~/.bashrc — as a FUNCTION, not an alias.
#
# THE COLLISION THIS FIXES (multi-host audit MH-11, a P0).
# This used to write `alias rc='… ravenclaude update && copilot --plugin-dir …'`,
# which SQUATTED on the name of the real front-door dispatcher at
# plugins/ravenclaude-core/bin/rc — the one that owns `rc dashboard`, `rc streams`
# and `rc converge`. With the alias active, the dashboard's own self-repair
# instruction — "open it via `rc dashboard`", the ONLY thing several empty states
# tell you to run — expanded to:
#
#     … ravenclaude update && copilot --plugin-dir … dashboard
#
# i.e. an update, then Copilot launched with a stray `dashboard` argument. The
# dashboard never opened. Worse, it misfired for precisely the users who ran the
# Copilot installer — the flagship non-Claude host, and the audience least able to
# tell that the instruction was wrong rather than the server being down.
#
# A function preserves BOTH documented behaviours instead of picking a winner:
#   `rc`            → update + launch Copilot live   (the one-word launcher)
#   `rc <verb> …`   → the real bin/rc dispatcher     (dashboard / streams / …)
# No rename, so nothing a user has already learned stops working.
add_rc_alias() {
  local bashrc="$HOME/.bashrc"
  local marker='# RavenClaude — rc launcher (added by ravenclaude setup)'
  if [ -f "$bashrc" ] && grep -qF 'RavenClaude — rc launcher' "$bashrc"; then
    note "rc launcher already in ~/.bashrc"
  else
    if [ -f "$bashrc" ] && grep -qF 'scripts/ravenclaude update && copilot --plugin-dir' "$bashrc"; then
      warn "an older 'alias rc=…' is present in ~/.bashrc — it SHADOWS 'rc dashboard'."
      warn "Remove that line, then re-run; the function below supersedes it."
    fi
    {
      printf '\n%s\n' "$marker"
      printf 'rc() {\n'
      printf '  if [ "$#" -gt 0 ]; then\n'
      printf '    # any verb goes to the real front-door dispatcher (rc dashboard, rc streams…)\n'
      printf '    command bash "%s/plugins/ravenclaude-core/bin/rc" "$@"\n' "$MARKET"
      printf '  else\n'
      printf '    # bare `rc` keeps the one-word "update and launch Copilot" behaviour\n'
      printf '    "%s/scripts/ravenclaude" update && copilot --plugin-dir "%s"\n' "$MARKET" "$COPILOT_PKG"
      printf '  fi\n'
      printf '}\n'
    } >>"$bashrc"
    ok "added 'rc' function to ~/.bashrc — bare 'rc' launches Copilot, 'rc dashboard' opens the dashboard"
  fi
}

# Drop the repo-local dashboard launch surfaces into a consumer project: a self-resolving
# .ravenclaude/dashboard.sh, a .ravenclaude/README.md with the link, and a one-click VS Code
# task. All scoped to <project> — they never touch the marketplace.
wire_dashboard_launchers() {
  local project="$1"
  local tpl="$CORE/templates/dashboard-launcher"
  [ -d "$tpl" ] || { warn "dashboard-launcher template missing ($tpl) — skipped"; return 0; }
  mkdir -p "$project/.ravenclaude"
  cp "$tpl/dashboard.sh" "$project/.ravenclaude/dashboard.sh"
  chmod +x "$project/.ravenclaude/dashboard.sh"

  # The README is static: the launcher (dashboard.sh) computes the dashboard URL at runtime,
  # so there is no environment-specific link to bake in (nothing to go stale per Codespace
  # rebuild) — copy it straight across, same as the other launcher files.
  cp "$tpl/README.md" "$project/.ravenclaude/README.md"

  mkdir -p "$project/.vscode"
  if [ -f "$project/.vscode/tasks.json" ]; then
    note "left existing .vscode/tasks.json alone — add the RavenClaude task from $tpl/tasks.json by hand"
  else
    cp "$tpl/tasks.json" "$project/.vscode/tasks.json"
  fi
  ok "wired dashboard launchers (.ravenclaude/dashboard.sh + README.md + .vscode task)"
}

regen() {
  if [ -f "$GEN" ] && command -v python3 >/dev/null 2>&1; then
    python3 "$GEN" >/dev/null 2>&1 && ok "regenerated the Copilot package" \
      || warn "could not regenerate the Copilot package (using the committed copy)"
  fi
}

cmd_update() {
  local project="$PWD"
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      *) project="$1"; shift ;;
    esac
  done
  printf '== ravenclaude update ==\n'
  if git -C "$MARKET" rev-parse --git-dir >/dev/null 2>&1; then
    local branch; branch="$(git -C "$MARKET" symbolic-ref --short HEAD 2>/dev/null || echo HEAD)"
    if git -C "$MARKET" pull --ff-only >/dev/null 2>&1; then
      ok "pulled latest ($branch)"
    else
      warn "git pull --ff-only failed (local changes or diverged?) — skills/hooks still update from whatever is checked out"
    fi
  else
    warn "$MARKET is not a git checkout — nothing to pull"
  fi
  regen
  # Self-heal the repo-local dashboard launchers when update is run from inside a wired
  # consumer repo, so an improved launcher / README arrives on `update` (or the `rc` alias),
  # not only on `setup`. Skip when we're sitting in the marketplace clone itself — that uses
  # open-dashboard.sh, not the consumer launcher.
  project="$(cd "$project" 2>/dev/null && pwd || echo "$project")"
  case "$project" in
    "$MARKET" | "$MARKET"/*) : ;; # inside the marketplace — nothing to re-wire
    *)
      if [ -d "$project/.ravenclaude" ]; then
        wire_dashboard_launchers "$project"
      fi
      ;;
  esac
  ok "up to date. In your Copilot session run '/skills reload' (or relaunch) to apply."

  # MH-17 — the update path is exactly where the Codex silent-disarm happens, so
  # this is exactly where it has to be said. A pull that changed any hook byte just
  # invalidated that hook's trust hash; Codex will SKIP it until re-trusted, and
  # the banner that would have told you is itself a skipped hook.
  #
  # Gated on the project actually being Codex-wired so a Copilot-only user never
  # sees a Codex instruction (the cross-host noise this audit is full of).
  if [ -f "$project/.codex/hooks.json" ]; then
    codex_retrust_notice "$project"
  fi
}

# Symlink one plugin's skills into <project>/.claude/skills. Used by cmd_install
# for ravenclaude-core (always) and each --with-plugin entry. Live symlinks so a
# `git pull` of the marketplace updates skills with zero re-copy; falls back to a
# cp -r where symlinks aren't supported (e.g. Windows without dev mode).
#
# Echoes the count of skills wired. A missing plugin name (no skills dir) prints
# a warning and echoes 0 — never fails the install.
wire_plugin_skills() {
  local project="$1" plugin_name="$2"
  local skills_src="$MARKET/plugins/$plugin_name/skills"
  if [ ! -d "$skills_src" ]; then
    warn "plugin '$plugin_name' has no skills/ directory (looked at $skills_src) — skipped"
    echo 0; return 0
  fi
  mkdir -p "$project/.claude/skills"
  local n=0
  for d in "$skills_src"/*/; do
    [ -d "$d" ] || continue
    local name; name="$(basename "$d")"
    local dest="$project/.claude/skills/$name"
    rm -rf "$dest"
    ln -s "$d" "$dest" 2>/dev/null || cp -r "$d" "$dest"
    n=$((n + 1))
  done
  echo "$n"
}

# wire_copilot_instructions <project>
#
# THE CLOSED LOOP THIS OPENS (multi-host audit MH-09, a P0).
# generate-copilot-plugin.py projects the whole claim-grounding discipline — plus
# the dashboard-launch instructions and the Relay-mode block — into
# plugins/ravenclaude-core/copilot/AGENTS.md. Copilot reads AGENTS.md natively,
# but ONLY from the user's own repo (knowledge/copilot-cli-customization.md §1).
# The marketplace clone is not the user's repo, so unless something points Copilot
# at it, that file is generated, freshness-gated, committed... and never loaded.
#
# The generated README told the user to export COPILOT_CUSTOM_INSTRUCTIONS_DIRS by
# hand. `ravenclaude setup` never did it, and an env var a human must remember is
# not wiring. Net effect: every Copilot session ran with NONE of the discipline the
# rest of this installer works to deliver, and nothing anywhere said so.
#
# `.github/copilot-instructions.md` is used rather than the env var because it is
# repo-local, survives a new shell, and travels with the project for teammates.
# We write a POINTER, never a copy: a copy would silently rot the moment the
# canonical AGENTS.md changed, and this repo has spent a whole release fixing
# exactly that failure shape.
wire_copilot_instructions() {
  local project="$1"
  local dest="$project/.github/copilot-instructions.md"
  local src="$MARKET/plugins/ravenclaude-core/copilot/AGENTS.md"
  if [ ! -f "$src" ]; then
    warn "copilot/AGENTS.md not found at $src — instruction pointer skipped"
    return 0
  fi
  mkdir -p "$project/.github" 2>/dev/null || true
  # Never clobber a hand-authored file: append our marked block once, idempotently.
  if [ -f "$dest" ] && grep -q 'RAVENCLAUDE-INSTRUCTIONS' "$dest" 2>/dev/null; then
    return 0
  fi
  {
    printf '\n<!-- RAVENCLAUDE-INSTRUCTIONS: managed pointer, safe to keep. -->\n'
    printf '## RavenClaude agent discipline\n\n'
    printf 'This project is wired to RavenClaude. Read the full cross-tool discipline —\n'
    printf 'claim grounding, capability grounding, the dashboard launch command, and the\n'
    printf 'relay-mode contract — at:\n\n'
    printf '    %s\n\n' "$src"
    printf 'That file is GENERATED from the canonical plugin and is freshness-gated, so it\n'
    printf 'is always current. Do not copy its contents here; read it there.\n'
  } >>"$dest"
  return 0
}

cmd_install() {
  local project="$PWD"
  local extra_plugins=()
  local host=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      --with-plugin) extra_plugins+=("$2"); shift 2 ;;
      --host) host="$2"; shift 2 ;;
      # MH-19 — opt in to third-party MCP servers BY NAME. Repeatable.
      --with-mcp) RC_WITH_MCP="${RC_WITH_MCP:+$RC_WITH_MCP,}$2"; export RC_WITH_MCP; shift 2 ;;
      *) shift ;;
    esac
  done
  project="$(cd "$project" && pwd)"
  if [ -z "$host" ]; then
    host="$(detect_host)"
  fi
  case "$host" in
    copilot|codex|cursor|aider|gemini) ;;
    *) warn "unknown --host '$host' (expected: copilot | codex | cursor | aider | gemini) — using copilot"; host="copilot" ;;
  esac
  printf '== ravenclaude install (host: %s) -> %s ==\n' "$host" "$project"

  # The Gemini lane (MH-30). The CHEAPEST lane in the marketplace, because
  # Gemini's hook contract is nearly Claude's: identical stdin field names, and
  # `exit 2` + stderr is ALREADY its block mechanism. The shim only normalises the
  # tool-name vocabulary (run_shell_command -> Bash, …) — which is not optional:
  # that exact mismatch is MH-01, where the tribunal was fully wired and reviewed
  # nothing because `bash` is not `Bash`.
  #
  # GEMINI.md IMPORTS AGENTS.md rather than copying it. Gemini supports `@file.md`
  # imports, so this is the ONE non-Claude host that can include the canonical file
  # directly — nothing to project, nothing to drift. Aider needed a real projection
  # only because CONVENTIONS.md has no import mechanism.
  if [ "$host" = "gemini" ]; then
    local ggen="$MARKET/scripts/generate-gemini-hooks.py"
    local gad="$CORE/hooks/gemini-hook-adapter.sh"
    mkdir -p "$project/.gemini"
    if [ -f "$ggen" ]; then
      local tmpcfg="$project/.gemini/.ravenclaude-hooks.json"
      if python3 "$ggen" --adapter "$gad" --hooks-dir "$CORE/hooks" --out "$tmpcfg"; then
        # Merge into .gemini/settings.json rather than overwriting: that file also
        # carries the user's model, theme and MCP config. Only the `hooks` key is
        # replaced, and only ours.
        python3 - "$project/.gemini/settings.json" "$tmpcfg" <<'PY2'
import json, sys, pathlib
dest, src = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
try:
    cur = json.loads(dest.read_text()) if dest.is_file() else {}
    if not isinstance(cur, dict):
        cur = {}
except Exception:
    cur = {}
add = json.loads(src.read_text())
cur["hooks"] = add.get("hooks", {})
cur["_ravenclaude_not_wired"] = add.get("_not_wired", [])
dest.write_text(json.dumps(cur, indent=2) + "\n")
PY2
        rm -f "$tmpcfg"
        ok "wired guardrails into .gemini/settings.json (projected; merged, not clobbered)"
      else
        warn "gemini hook projection FAILED — no guardrails wired"
      fi
    else
      warn "generate-gemini-hooks.py missing — Gemini guardrails NOT wired"
    fi

    # The instruction lane: an IMPORT, not a copy.
    if [ -f "$project/GEMINI.md" ] && grep -q 'RAVENCLAUDE-IMPORT' "$project/GEMINI.md" 2>/dev/null; then
      note "GEMINI.md already imports AGENTS.md — left alone"
    else
      {
        printf '\n<!-- RAVENCLAUDE-IMPORT: managed pointer, safe to keep. -->\n'
        printf '# Project context\n\n'
        printf 'The canonical cross-tool guidance for this repository is AGENTS.md.\n'
        printf 'It is imported below rather than copied, so it can never drift:\n\n'
        printf '@AGENTS.md\n'
      } >>"$project/GEMINI.md"
      ok "GEMINI.md imports AGENTS.md via @-import (no copy, nothing to drift)"
    fi

    note "NOT enforced under Gemini: the layout gate. Its path arrives as argv and"
    note "  Gemini's tool_input path FIELD NAME is unverified — wiring it would look"
    note "  enforced while silently no-opping. CI is the backstop; see the skip list"
    note "  in .gemini/settings.json (_ravenclaude_not_wired)."
    wire_dashboard_launchers "$project"
    if [ -z "${RC_FROM_SETUP:-}" ]; then
      printf '\n'
      ok "install complete. Launch: gemini (reads .gemini/settings.json from this dir)."
    fi
    return 0
  fi

  # The Aider lane (MH-26). The ONLY lane that bridges no enforcement, because
  # Aider has no hooks API — nothing here can gate an Aider session in-loop, and
  # the generated file says so rather than implying coverage it does not have.
  #
  # Aider reads CONVENTIONS.md, and ONLY on explicit opt-in (`--read`, or a `read:`
  # entry in .aider.conf.yml) — docs-verified. So a pointer file would not be read
  # and documentation alone would not opt in. Both halves are required for the
  # corrected claim to become actionable instead of merely honest.
  if [ "$host" = "aider" ]; then
    local agen="$MARKET/scripts/generate-aider-conventions.py"
    if [ -f "$agen" ]; then
      if python3 "$agen" --out "$project/CONVENTIONS.md" --conf-out "$project/.aider.conf.yml"; then
        ok "projected AGENTS.md -> CONVENTIONS.md + wrote .aider.conf.yml (read: opt-in)"
      else
        warn "aider projection FAILED — CONVENTIONS.md not written"
      fi
    else
      warn "generate-aider-conventions.py missing — Aider files NOT written"
    fi
    note "⚠ NO guardrail runs under Aider — it has no hooks API. CI is the only"
    note "  backstop on this host, and CONVENTIONS.md states that plainly."
    note "If .aider.conf.yml already existed it was OVERWRITTEN — merge by hand if"
    note "  you had other keys in it."
    wire_dashboard_launchers "$project"
    if [ -z "${RC_FROM_SETUP:-}" ]; then
      printf '\n'
      ok "install complete. Launch: aider (it reads .aider.conf.yml from this dir)."
    fi
    return 0
  fi

  # The Cursor lane (MH-13 + MH-25).
  if [ "$host" = "cursor" ]; then
    wire_cursor "$project"
    wire_dashboard_launchers "$project"
    if [ -z "${RC_FROM_SETUP:-}" ]; then
      printf '\n'
      ok "install complete. Open this project in Cursor as usual."
      note "Updates: run 'ravenclaude update' — hooks load live from this checkout."
    fi
    return 0
  fi

  # The Codex lane. Kept as a HOST DIMENSION on the one installer rather than a
  # second installer (MH-07): the skills are the same 50 directories and the hooks
  # are the same 18 scripts — only the paths they are wired into differ.
  if [ "$host" = "codex" ]; then
    local n_codex
    n_codex="$(wire_codex_skills "$project" "ravenclaude-core")"
    ok "wired $n_codex skills from ravenclaude-core into .agents/skills"
    if [ "${#extra_plugins[@]}" -gt 0 ]; then
      local cplugin
      for cplugin in "${extra_plugins[@]}"; do
        [ -z "$cplugin" ] && continue
        local n_cx; n_cx="$(wire_codex_skills "$project" "$cplugin")"
        ok "wired $n_cx skills from $cplugin"
      done
    fi

    wire_codex_hooks "$project"
    ok "wired hooks into .codex/hooks.json (native contract — no adapter)"

    # AGENTS.md is read natively from the repo root by Codex [docs-verified], so
    # unlike Copilot (MH-09) no instruction-pointer file is needed here.
    note "AGENTS.md is read natively by Codex from the repo root — no pointer needed."

    # Sandbox posture (MH-16 part 2). Projects the comfort posture onto Codex's
    # two real controls. NEVER silently weakens an existing value, and never emits
    # danger-full-access / approval_policy = "never" at any posture.
    local emitter="$MARKET/scripts/emit-codex-config.py"
    if [ -f "$emitter" ] && [ -f "$project/.ravenclaude/comfort-posture.yaml" ]; then
      python3 "$emitter" --project "$project" || true
      ok "projected the comfort posture onto .codex/config.toml"
      note "COARSE BY DESIGN: two enum keys cannot express 12 posture categories."
      note "  Codex's OS sandbox (default-on, workspace-write) is your real boundary."
      note "  A project .codex/config.toml loads ONLY IN TRUSTED PROJECTS — like the"
      note "  hooks above, writing the file is not the same as bounding the session."
    else
      note "NOT wired: sandbox_mode / approval_policy — no comfort-posture.yaml here."
      note "  Run 'ravenclaude setup' to seed one, or set the two keys by hand."
    fi

    # HONEST GAP, stated at install time rather than discovered later:
    note "NOT wired: MCP servers (.codex/config.toml [mcp]) — the TOML merge is not"
    note "  built yet; a bad merge would clobber a hand-tuned config. Add by hand."

    wire_dashboard_launchers "$project"
    codex_retrust_notice "$project"
    if [ -z "${RC_FROM_SETUP:-}" ]; then
      printf '\n'
      ok "install complete. Launch Codex from $project as usual."
      note "Updates: run 'ravenclaude update', then /hooks in Codex to re-trust."
    fi
    return 0
  fi

  # 1. Skills — wire ravenclaude-core (the base kit) into <project>/.claude/skills,
  #    plus any extra plugins requested via --with-plugin. Skills are read live by
  #    Copilot and Claude, so the symlink is the only wiring needed.
  local n_core
  n_core="$(wire_plugin_skills "$project" "ravenclaude-core")"
  ok "wired $n_core skills from ravenclaude-core into .claude/skills"

  # 1a. Is the running Copilot new enough for the guardrails below to actually
  #     fire? Checked BEFORE wiring, so the warning is the first thing seen rather
  #     than the last line after a wall of successes (audit MH-23).
  copilot_version_check

  # 1b. Point Copilot at the projected discipline. Without this the generated
  #     copilot/AGENTS.md is never loaded by any session (audit MH-09).
  wire_copilot_instructions "$project"
  ok "pointed .github/copilot-instructions.md at the projected agent discipline"
  if [ "${#extra_plugins[@]}" -gt 0 ]; then
    local plugin
    for plugin in "${extra_plugins[@]}"; do
      [ -z "$plugin" ] && continue
      local n_extra
      n_extra="$(wire_plugin_skills "$project" "$plugin")"
      ok "wired $n_extra skills from $plugin"
    done
  fi

  # 2. Hooks (multi-host audit MH-12). PROJECTED from the canonical manifest by
  #    scripts/generate-copilot-hooks.py — no longer a hand-maintained list here.
  #
  #    WHY: this used to be an inline Python heredoc naming hooks one by one. It
  #    wired 11; the canonical manifest registers 24. So FOURTEEN shipped
  #    guardrails never fired under Copilot at all — the web-access guard, the
  #    worktree guard, both Muninn hooks, the delegation nudge, and more — and
  #    nothing enforced that the two lists agreed, so the drift was invisible and
  #    grew with every release. The projector now derives the wiring, carries the
  #    canonical MATCHERS through (Copilot applies Claude matcher semantics under
  #    PascalCase event names), and Gate 158 fails the build if any canonical hook
  #    is neither wired nor explicitly skipped with a reason.
  mkdir -p "$project/.github/hooks"
  local adapter="$CORE/hooks/copilot-hook-adapter.sh"
  local hookgen="$MARKET/scripts/generate-copilot-hooks.py"
  if [ -f "$hookgen" ]; then
    python3 "$hookgen" --adapter "$adapter" --hooks-dir "$CORE/hooks" \
      --out "$project/.github/hooks/ravenclaude.json" || {
        warn "hook projection failed — .github/hooks/ravenclaude.json NOT written"
        warn "  Copilot guardrails are NOT wired for this project. Re-run after fixing."
      }
  else
    warn "generate-copilot-hooks.py missing at $hookgen — hooks NOT wired"
  fi
  ok "wired hooks into .github/hooks/ravenclaude.json (via the Copilot adapter)"

  # 3. MCP: OPT-IN ONLY (MH-19). Nothing is installed unless the user named it
  #    with --with-mcp. Why wholesale merging would be wrong: on Claude Code you
  #    get a plugin's MCP server BECAUSE you installed that plugin; Copilot's
  #    ~/.copilot/mcp-config.json is GLOBAL and has no per-plugin step, so naming
  #    the server IS the consent. Every catalogue entry is third-party software
  #    that will run on this machine, and one of them is write-capable.
  local mcp_catalog="$COPILOT_PKG/mcp-catalog.json"
  local mcp_dest="${COPILOT_HOME:-$HOME/.copilot}/mcp-config.json"
  if [ -n "${RC_WITH_MCP:-}" ]; then
    if [ -f "$mcp_catalog" ]; then
      mkdir -p "$(dirname "$mcp_dest")"
      if python3 "$MARKET/scripts/install-copilot-mcp.py" \
           --catalog "$mcp_catalog" --dest "$mcp_dest" --servers "$RC_WITH_MCP"; then
        ok "installed the requested MCP server(s) into $mcp_dest"
        note "THIRD-PARTY: these run on your machine. Remove by editing that file."
      else
        warn "no MCP server installed — see the error above"
      fi
    else
      warn "MCP catalogue missing at $mcp_catalog — run 'ravenclaude update'"
    fi
  else
    note "mcp: none installed (opt in with --with-mcp <server>; 'ravenclaude status' lists them)"
  fi

  # 4. The launch alias — one command that updates then launches Copilot live.
  #    Suppressed when invoked by `setup`, which writes the alias to ~/.bashrc itself.
  if [ -z "${RC_FROM_SETUP:-}" ]; then
    printf '\nAdd this to your shell rc (~/.bashrc / ~/.zshrc) for one-command use:\n\n'
    printf "  alias rc='%s/scripts/ravenclaude update && copilot --plugin-dir %s'\n\n" "$MARKET" "$COPILOT_PKG"
    ok "install complete. Launch with:  copilot --plugin-dir $COPILOT_PKG"
    note "Updates from now on: just run 'ravenclaude update' (or 'rc'). No re-install, ever."
  fi
}

cmd_status() {
  local project="$PWD"
  local fix=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      --fix) fix=1; shift ;;
      *) project="$1"; shift ;;
    esac
  done
  project="$(cd "$project" && pwd)"
  printf '== ravenclaude status -> %s ==\n' "$project"
  [ -d "$project/.claude/skills" ] && note "skills:  $(find "$project/.claude/skills" -maxdepth 1 -mindepth 1 -type l -o -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ') in .claude/skills" || note "skills:  not wired"
  [ -f "$project/.github/hooks/ravenclaude.json" ] && note "hooks:   .github/hooks/ravenclaude.json present" || note "hooks:   not wired"

  # Codex lane (MH-07). Reported separately and only when present, so a
  # Copilot-only project's status output is byte-identical to before.
  if [ -d "$project/.agents/skills" ] || [ -f "$project/.codex/hooks.json" ]; then
    [ -d "$project/.agents/skills" ] \
      && note "codex:   $(find "$project/.agents/skills" -maxdepth 1 -mindepth 1 \( -type l -o -type d \) 2>/dev/null | wc -l | tr -d ' ') skills in .agents/skills" \
      || note "codex:   skills not wired (.agents/skills absent)"
    if [ -f "$project/.codex/hooks.json" ]; then
      note "codex:   $(codex_hook_count "$project/.codex/hooks.json") hooks in .codex/hooks.json — run /hooks in Codex to confirm they are TRUSTED"
    else
      note "codex:   hooks not wired (.codex/hooks.json absent)"
    fi
    # The sandbox is the boundary that actually bounds a Codex session, so status
    # reports the live values rather than only what we wired. Read with the same
    # top-level-key discipline the emitter uses (a key under a [table] is NOT it).
    if [ -f "$project/.codex/config.toml" ]; then
      local _sb; _sb="$(awk -F= '/^[[:space:]]*\[/{t=1} !t && /^[[:space:]]*sandbox_mode[[:space:]]*=/{print $2; exit}' "$project/.codex/config.toml" | tr -d ' "')"
      local _ap; _ap="$(awk -F= '/^[[:space:]]*\[/{t=1} !t && /^[[:space:]]*approval_policy[[:space:]]*=/{print $2; exit}' "$project/.codex/config.toml" | tr -d ' "')"
      note "codex:   sandbox ${_sb:-<unset>} · approval ${_ap:-<unset>} (loads only in TRUSTED projects)"
    else
      note "codex:   no .codex/config.toml — Codex's own default sandbox (workspace-write) applies"
    fi
  fi
  # MH-19 — the old line printed "not configured", which reads as "you have not
  # set it up" when the truth is "ravenclaude-core ships NO MCP servers; the four
  # that exist live in other plugins and are opt-in here". Say which, and list them.
  if [ -f "$COPILOT_PKG/mcp-catalog.json" ]; then
    python3 "$MARKET/scripts/install-copilot-mcp.py" --catalog "$COPILOT_PKG/mcp-catalog.json" \
      --dest "${COPILOT_HOME:-$HOME/.copilot}/mcp-config.json" --status 2>/dev/null \
      | while IFS= read -r _l; do note "$_l"; done
  else
    note "mcp:     catalogue missing — run 'ravenclaude update'"
  fi
  copilot_version_check
  [ -d "$COPILOT_PKG" ] && note "package: $COPILOT_PKG" || note "package: MISSING — run 'ravenclaude update' to generate it"

  # Dashboard launcher check (v0.113.2): added because pre-v0.44.0 `ravenclaude
  # setup` installs predate the launcher template and never got the per-repo
  # dashboard.sh / README.md / .vscode/tasks.json. Without these, the consumer
  # can't open the comfort-posture editor scoped to their repo — they have to
  # remember the command.
  local launcher="$project/.ravenclaude/dashboard.sh"
  local readme="$project/.ravenclaude/README.md"
  local vstask="$project/.vscode/tasks.json"
  local launcher_missing=0
  [ -f "$launcher" ] || launcher_missing=1
  [ -f "$readme" ] || launcher_missing=1
  [ -f "$vstask" ] || launcher_missing=1
  if [ "$launcher_missing" -eq 0 ]; then
    note "launcher: .ravenclaude/dashboard.sh + README.md + VS Code task present"
  else
    if [ "$fix" -eq 1 ]; then
      note "launcher: MISSING — installing now"
      wire_dashboard_launchers "$project"
    else
      note "launcher: MISSING — run 'ravenclaude status --fix --project $project' to install"
      [ ! -f "$launcher" ] && note "          ↳ .ravenclaude/dashboard.sh absent"
      [ ! -f "$readme" ]   && note "          ↳ .ravenclaude/README.md absent"
      [ ! -f "$vstask" ]   && note "          ↳ .vscode/tasks.json absent"
    fi
  fi
}

cmd_setup() {
  local project="$PWD"
  local install_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      --with-plugin) install_args+=("--with-plugin" "$2"); shift 2 ;;
      *) project="$1"; shift ;;
    esac
  done
  project="$(cd "$project" && pwd)"
  printf '== ravenclaude setup -> %s ==\n' "$project"

  # 1. Wire skills + hooks + MCP (RC_FROM_SETUP suppresses install's alias hint).
  #    Threads any --with-plugin entries through to cmd_install.
  export RC_FROM_SETUP=1
  cmd_install --project "$project" "${install_args[@]:-}"
  unset RC_FROM_SETUP

  # 2. Seed a balanced comfort-posture if the repo doesn't already have one.
  local posture="$project/.ravenclaude/comfort-posture.yaml"
  local seed="$CORE/templates/comfort-posture-balanced.yaml"
  if [ -f "$posture" ]; then
    note "comfort-posture.yaml already present — left as-is"
  elif [ -f "$seed" ]; then
    mkdir -p "$project/.ravenclaude"
    cp "$seed" "$posture"
    ok "seeded .ravenclaude/comfort-posture.yaml (balanced default)"
  else
    warn "balanced posture template missing ($seed) — skipped posture seed"
  fi

  # 3. Apply the posture to .claude/settings.json (best-effort).
  local apply="$CORE/scripts/apply-comfort-posture.py"
  if [ -f "$posture" ] && [ -f "$apply" ] && command -v python3 >/dev/null 2>&1; then
    python3 "$apply" --project-root "$project" >/dev/null 2>&1 \
      && ok "applied comfort-posture -> .claude/settings.json" \
      || warn "could not apply comfort-posture (open the dashboard or run /set-posture later)"
  fi

  # 4. The one-word launch alias.
  add_rc_alias

  # 5. Repo-local comfort-posture dashboard launchers (scoped to this repo).
  wire_dashboard_launchers "$project"

  ok "setup complete."
  note ""
  note "Launch Copilot (in a NEW terminal so ~/.bashrc is loaded):"
  note "    rc"
  note "  From a non-interactive shell (e.g. inside a Copilot session itself):"
  note "    bash -i -c rc"
  note "  Or skip the alias entirely:"
  note "    copilot --plugin-dir $COPILOT_PKG"
  note ""
  note "Dashboard (comfort-posture editor):"
  if [ -n "${CODESPACES:-}" ] || [ -n "${CODESPACE_NAME:-}" ]; then
    note "    auto-launches on next Codespace start at the forwarded port 8000"
    note "    (Ports panel → 'RavenClaude dashboard' → Open in Browser)"
    note "  Run it now without restarting:"
  else
    note "    auto-launches on every Codespace start at http://127.0.0.1:8000"
    note "  Or run it now:"
  fi
  note "    bash .ravenclaude/dashboard.sh"
  note "    # (or the VS Code task: 'RavenClaude: Comfort-posture dashboard')"
}

cmd_init_codespace() {
  local project="$PWD"
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      *) project="$1"; shift ;;
    esac
  done
  project="$(cd "$project" && pwd)"
  printf '== ravenclaude init-codespace -> %s ==\n' "$project"
  local tpl="$CORE/templates/codespace-copilot"
  [ -d "$tpl" ] || { warn "template missing: $tpl"; return 1; }
  mkdir -p "$project/.devcontainer"
  local existing="$project/.devcontainer/devcontainer.json"
  if [ -f "$existing" ]; then
    warn ".devcontainer/devcontainer.json exists — NOT overwritten."
    # Check which of the four merge-required keys are missing from the existing
    # file, and list ONLY those (so a partial existing devcontainer doesn't get
    # the same generic warning as a virgin one). Falls back to listing all four
    # if python3/jq are unavailable.
    local missing=()
    if command -v python3 >/dev/null 2>&1; then
      local report
      report="$(python3 - "$existing" <<'PY' 2>/dev/null || true
import json, re, sys
try:
    raw = open(sys.argv[1]).read()
    # Strip // line comments so the devcontainer JSONC parses.
    raw = re.sub(r"//[^\n]*", "", raw)
    cfg = json.loads(raw)
except Exception:
    print("ALL")
    raise SystemExit
required = ["postCreateCommand", "postStartCommand", "forwardPorts", "portsAttributes"]
missing = [k for k in required if k not in cfg]
# postCreateCommand is "present" but still needs to invoke our post-create script.
if "postCreateCommand" in cfg:
    pc = cfg["postCreateCommand"]
    if isinstance(pc, str) and "ravenclaude-post-create.sh" not in pc:
        missing.insert(0, "postCreateCommand (must invoke ravenclaude-post-create.sh)")
print("\n".join(missing) if missing else "NONE")
PY
)"
      if [ "$report" = "NONE" ]; then
        note "  all four merge keys already present — nothing to merge"
      elif [ "$report" = "ALL" ] || [ -z "$report" ]; then
        note "  merge these keys from $tpl/devcontainer.json:"
        note "    - postCreateCommand   (must invoke .devcontainer/ravenclaude-post-create.sh)"
        note "    - postStartCommand    (auto-launches the dashboard on every Codespace start/resume)"
        note "    - forwardPorts        (pre-forwards port 8000 so the Ports panel shows it)"
        note "    - portsAttributes     (labels port 8000 and opens it in the browser)"
      else
        note "  merge these missing keys from $tpl/devcontainer.json:"
        while IFS= read -r k; do
          [ -n "$k" ] && note "    - $k"
        done <<<"$report"
      fi
    else
      note "  merge these keys from $tpl/devcontainer.json:"
      note "    - postCreateCommand   (must invoke .devcontainer/ravenclaude-post-create.sh)"
      note "    - postStartCommand    (auto-launches the dashboard on every Codespace start/resume)"
      note "    - forwardPorts        (pre-forwards port 8000)"
      note "    - portsAttributes     (labels port 8000, opens in browser)"
    fi
  else
    cp "$tpl/devcontainer.json" "$existing"
    ok "wrote .devcontainer/devcontainer.json"
  fi
  cp "$tpl/ravenclaude-post-create.sh" "$project/.devcontainer/ravenclaude-post-create.sh"
  chmod +x "$project/.devcontainer/ravenclaude-post-create.sh"
  ok "wrote .devcontainer/ravenclaude-post-create.sh"
  note "Commit .devcontainer/ and (re)build the Codespace — setup then runs automatically."
}

cmd_dashboard() {
  local project="$PWD" port="8000"
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      --port) port="$2"; shift 2 ;;
      *) project="$1"; shift ;;
    esac
  done
  project="$(cd "$project" && pwd)"
  local server="$CORE/scripts/serve-dashboards.py"
  [ -f "$server" ] || { warn "dashboard server missing: $server"; return 1; }
  printf '== ravenclaude dashboard -> %s ==\n' "$project"
  note "Open the URL it prints (Codespace: Ports panel -> Open in Browser). Ctrl+C to stop."
  # --project-root pins the repo; the server hard-refuses if it ever resolves to the marketplace.
  exec python3 "$server" --project-root "$project" --port "$port"
}

cmd_doctor() {
  # ravenclaude doctor — repo health check.
  # Five checks, each prints OK / WARN / FAIL. Exits 0 if no FAIL, 1 otherwise.
  # Designed to be safe to run anywhere — never mutates state.
  local fail=0 warning=0
  local project="$PWD"
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      *) project="$1"; shift ;;
    esac
  done
  project="$(cd "$project" && pwd)"
  printf '== ravenclaude doctor -> %s ==\n' "$project"

  # 1. .repo-layout.json present + parses
  if [ -f "$project/.repo-layout.json" ]; then
    if python3 -m json.tool "$project/.repo-layout.json" >/dev/null 2>&1; then
      ok ".repo-layout.json parses"
    else
      printf '\033[31mx\033[0m .repo-layout.json present but invalid JSON\n'; fail=$((fail+1))
    fi
  else
    warn ".repo-layout.json missing (run /init-agent-ready to seed)"; warning=$((warning+1))
  fi

  # 2. .ravenclaude/comfort-posture.yaml present (informational)
  if [ -f "$project/.ravenclaude/comfort-posture.yaml" ]; then
    ok "comfort-posture.yaml present"
  else
    warn "comfort-posture.yaml missing (run /dashboard or /set-posture)"; warning=$((warning+1))
  fi

  # 3. .claude/settings.json present + parses (the applied posture)
  if [ -f "$project/.claude/settings.json" ]; then
    if python3 -m json.tool "$project/.claude/settings.json" >/dev/null 2>&1; then
      ok ".claude/settings.json parses"
    else
      printf '\033[31mx\033[0m .claude/settings.json present but invalid JSON\n'; fail=$((fail+1))
    fi
  else
    warn ".claude/settings.json missing (Claude Code will use built-in defaults)"; warning=$((warning+1))
  fi

  # 4. Knowledge-health summary (if running in the marketplace repo)
  if [ -d "$project/plugins" ] && [ -x "$project/plugins/ravenclaude-core/scripts/knowledge-health.py" ]; then
    local out stale untracked
    out="$(python3 "$project/plugins/ravenclaude-core/scripts/knowledge-health.py" --json 2>/dev/null)" || out=""
    if [ -n "$out" ]; then
      stale="$(printf '%s' "$out" | python3 -c "import json,sys; print(json.load(sys.stdin)['counts']['stale'])" 2>/dev/null)"
      untracked="$(printf '%s' "$out" | python3 -c "import json,sys; print(json.load(sys.stdin)['counts']['untracked'])" 2>/dev/null)"
      if [ "${stale:-0}" -gt 0 ]; then
        printf '\033[31mx\033[0m knowledge-health: %s stale file(s); run scripts/knowledge-health.py\n' "$stale"
        fail=$((fail+1))
      elif [ "${untracked:-0}" -gt 0 ]; then
        warn "knowledge-health: ${untracked} untracked file(s) (missing Last reviewed: date)"; warning=$((warning+1))
      else
        ok "knowledge-health: nothing stale"
      fi
    fi
  fi

  # 5. Layout-gate self-check (every committed file matches an allowed glob)
  if [ -x "$project/scripts/check-layout.py" ]; then
    if (cd "$project" && python3 scripts/check-layout.py --all >/dev/null 2>&1); then
      ok "layout-gate: every file matches an allowed_glob"
    else
      printf '\033[31mx\033[0m layout-gate: some files do NOT match .repo-layout.json - run scripts/check-layout.py\n'
      fail=$((fail+1))
    fi
  fi

  # 6. Plugin version alignment — every plugin.json version matches its
  #    marketplace.json entry. Reuses scripts/check-marketplace-claims.py as a
  #    subprocess (single source of truth for marketplace drift checks).
  if [ -x "$project/scripts/check-marketplace-claims.py" ]; then
    if (cd "$project" && python3 scripts/check-marketplace-claims.py >/dev/null 2>&1); then
      ok "plugin version alignment: all plugins match marketplace.json"
    else
      printf '\033[31mx\033[0m plugin version alignment: plugin.json/marketplace.json drift detected - run scripts/check-marketplace-claims.py\n'
      fail=$((fail+1))
    fi
  fi

  # 7. Worktree + run-artifact age — surface aging artifacts before they
  #    become confusing. Worktree >90 days → fail (likely abandoned); >30 days
  #    → warn. Run dirs >90 days → warn (archival hint, never fail — may
  #    contain partner-confidential artifacts the user should hand-archive).
  if [ -d "$project/.claude/worktrees" ]; then
    local wt_old=0 wt_warn=0
    for wt in "$project"/.claude/worktrees/*/; do
      [ -d "$wt" ] || continue
      local age_days
      # Pass path via env var so a worktree dir name with shell- or Python-
      # injectable characters can't escape into the source. The slug
      # enforced by worktree-new.sh is safe, but doctor surveys whatever
      # exists on disk, including dirs created by other means.
      age_days="$(WT="$wt" python3 -c 'import os,time; print(int((time.time()-os.path.getmtime(os.environ["WT"]))/86400))' 2>/dev/null)"
      if [ "${age_days:-0}" -gt 90 ]; then wt_old=$((wt_old+1))
      elif [ "${age_days:-0}" -gt 30 ]; then wt_warn=$((wt_warn+1))
      fi
    done
    if [ "$wt_old" -gt 0 ]; then
      printf '\033[31mx\033[0m worktree hygiene: %s worktree(s) > 90 days old; run scripts/worktree-clean.sh --status\n' "$wt_old"
      fail=$((fail+1))
    elif [ "$wt_warn" -gt 0 ]; then
      warn "worktree hygiene: ${wt_warn} worktree(s) > 30 days old"; warning=$((warning+1))
    else
      ok "worktree hygiene: no aging worktrees"
    fi
  fi
  if [ -d "$project/.ravenclaude/runs" ]; then
    local run_old=0
    for r in "$project"/.ravenclaude/runs/*/; do
      [ -d "$r" ] || continue
      local age_days
      # Same env-var pattern as the worktree loop above — run dir names
      # come from agent dispatch (.ravenclaude/runs/<slug>/) and could
      # in principle contain unexpected characters.
      age_days="$(RDIR="$r" python3 -c 'import os,time; print(int((time.time()-os.path.getmtime(os.environ["RDIR"]))/86400))' 2>/dev/null)"
      if [ "${age_days:-0}" -gt 90 ]; then run_old=$((run_old+1)); fi
    done
    if [ "$run_old" -gt 0 ]; then
      warn "run-artifact hygiene: ${run_old} run dir(s) > 90 days old (archive if no longer needed)"; warning=$((warning+1))
    else
      ok "run-artifact hygiene: no aging runs"
    fi
  fi

  printf -- '----\n'
  if [ "$fail" -eq 0 ] && [ "$warning" -eq 0 ]; then
    ok "doctor: all checks passed"
    return 0
  fi
  if [ "$fail" -eq 0 ]; then
    note "doctor: $warning warning(s); no hard failures"
    return 0
  fi
  warn "doctor: $fail failure(s), $warning warning(s)"
  return 1
}

case "${1:-}" in
  setup)          shift; cmd_setup "$@" ;;
  install)        shift; cmd_install "$@" ;;
  update)         shift; cmd_update "$@" ;;
  status)         shift; cmd_status "$@" ;;
  dashboard)      shift; cmd_dashboard "$@" ;;
  doctor)         shift; cmd_doctor "$@" ;;
  init-codespace) shift; cmd_init_codespace "$@" ;;
  *) printf 'usage: ravenclaude {setup|install|update|status|dashboard|doctor|init-codespace} [--project DIR]\n'; exit 2 ;;
esac
